@{
    ViewData["Title"] = "Change password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>-</title>
    <link rel="stylesheet"
          href="https://cdn3.devexpress.com/jslib/25.2.7/css/dx.light.css" />
    <style>
            *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

            body {
                font-family: "Segoe UI", Calibri, sans-serif;
                background: #ffffff;
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .login-card {
                background: #fff;
                border-radius: 12px;
                border: 1px solid #c8d4e6;
                box-shadow: 0 4px 24px rgba(0,0,0,.08);
                width: 50%;
                max-width: 440px;
                padding: 40px 36px 36px;
            }

            .login-brand {
                text-align: center;
                margin-bottom: 8px;
            }

            .login-brand-title {
                font-size: 1.25rem;
                font-weight: 700;
                color: #192b45;
                letter-spacing: -.3px;
            }

            .login-brand-sub {
                font-size: .8rem;
                color: #888;
                margin-top: 4px;
            }

            .login-divider {
                border: none;
                border-top: 1px solid #eaeef3;
                margin: 20px 0 24px;
            }

            .login-field { margin-bottom: 16px; }

            .login-field label {
                display: block;
                font-size: .72rem;
                font-weight: 600;
                color: #444;
                margin-bottom: 5px;
                text-transform: uppercase;
                letter-spacing: .4px;
            }

            .login-btn-wrap { margin-top: 8px; }

            .login-error {
                background: #fdecea;
                border: 1px solid #f5c6cb;
                border-radius: 6px;
                padding: 10px 14px;
                font-size: .82rem;
                color: #c62828;
                margin-bottom: 16px;
            }

            .login-footer {
                text-align: center;
                margin-top: 20px;
                font-size: .72rem;
                color: #aaa;
            }

            /* Password rules checklist — same markup/behavior as Users/Index.cshtml's
               create/edit-user password fields, kept visually consistent with them. */
            .pw-rules {
                display: flex;
                flex-direction: column;
                gap: 4px;
                margin: -8px 0 16px;
            }

            .pw-rule {
                font-size: .74rem;
                color: #9ca3af;
                display: flex;
                align-items: center;
                gap: 6px;
            }

                .pw-rule.met { color: #192b45; }

                .pw-rule .dot {
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: #d1d5db;
                    flex-shrink: 0;
                }

                .pw-rule.met .dot { background: #192b45; }
    </style>
</head>
<body>

    <div class="login-card">

        <div class="login-brand">
            <div class="login-brand-title">Change your password</div>
            <div class="login-brand-sub">
                This account was set up with a temporary password. Choose your own
                before continuing.
            </div>
        </div>

        <hr class="login-divider" />

        @if (TempData["ChangePasswordError"] != null)
        {
            <div class="login-error">@TempData["ChangePasswordError"]</div>
        }

        <form method="post" action="/Account/ChangePassword" id="changePwForm">
            @Html.AntiForgeryToken()

            <div class="login-field">
                <label>Current (temporary) password</label>
                <div id="currentPwBox"></div>
                <input type="hidden" id="currentPwVal" name="currentPassword" />
            </div>

            <div class="login-field">
                <label>New password</label>
                <div id="newPwBox"></div>
                <input type="hidden" id="newPwVal" name="newPassword" />
            </div>

            <div class="pw-rules" id="newPwRules">
                <div class="pw-rule" data-rule="length"><span class="dot"></span><span>At least 12 characters</span></div>
                <div class="pw-rule" data-rule="upper"><span class="dot"></span><span>One uppercase letter</span></div>
                <div class="pw-rule" data-rule="lower"><span class="dot"></span><span>One lowercase letter</span></div>
                <div class="pw-rule" data-rule="digit"><span class="dot"></span><span>One number</span></div>
                <div class="pw-rule" data-rule="symbol"><span class="dot"></span><span>One symbol</span></div>
                <div class="pw-rule" data-rule="unique"><span class="dot"></span><span>At least 4 unique characters</span></div>
            </div>

            <div class="login-field">
                <label>Confirm new password</label>
                <div id="confirmPwBox"></div>
                <input type="hidden" id="confirmPwVal" name="confirmPassword" />
            </div>

            <div class="login-btn-wrap">
                <div id="btnChangePw"></div>
            </div>
        </form>

        <div class="login-footer">
            Having trouble? Contact your system administrator.
        </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/25.2.7/js/dx.all.js"></script>
    <script>
        $(function () {
            
            var pwRuleDefs = [
                { key: "length", test: function (v) { return v.length >= 12; } },
                { key: "upper",  test: function (v) { return /[A-Z]/.test(v); } },
                { key: "lower",  test: function (v) { return /[a-z]/.test(v); } },
                { key: "digit",  test: function (v) { return /[0-9]/.test(v); } },
                { key: "symbol", test: function (v) { return /[^A-Za-z0-9]/.test(v); } },
                { key: "unique", test: function (v) { return new Set(v.split("")).size >= 4; } }
            ];

            function passwordMeetsPolicy(v) {
                return pwRuleDefs.every(function (r) { return r.test(v || ""); });
            }

            function updatePasswordRulesUi(value) {
                pwRuleDefs.forEach(function (r) {
                    $('#newPwRules [data-rule="' + r.key + '"]').toggleClass('met', r.test(value || ""));
                });
            }

            var currentPwInst = $("#currentPwBox").dxTextBox({
                placeholder: "Temporary password",
                mode: "password",
                onValueChanged: function (e) { $("#currentPwVal").val(e.value); }
            }).dxTextBox("instance");

            var newPwInst = $("#newPwBox").dxTextBox({
                placeholder: "New password",
                mode: "password",
                onValueChanged: function (e) {
                    $("#newPwVal").val(e.value);
                    updatePasswordRulesUi(e.value);
                }
            }).dxTextBox("instance");

            var confirmPwInst = $("#confirmPwBox").dxTextBox({
                placeholder: "Confirm new password",
                mode: "password",
                onValueChanged: function (e) { $("#confirmPwVal").val(e.value); },
                onEnterKey: function () { submit(); }
            }).dxTextBox("instance");

            $("#btnChangePw").dxButton({
                text: "Change password",
                type: "default",
                icon: "key",
                width: "100%",
                onClick: function () { submit(); }
            });

            function submit() {
                var current = currentPwInst.option("value");
                var next = newPwInst.option("value");
                var confirm = confirmPwInst.option("value");

                if (!current) {
                    DevExpress.ui.notify("Enter your current (temporary) password.", "warning", 2500);
                    currentPwInst.focus();
                    return;
                }
                if (!passwordMeetsPolicy(next)) {
                    DevExpress.ui.notify("Your new password doesn't meet all the requirements above.", "warning", 3000);
                    newPwInst.focus();
                    return;
                }
                if (next !== confirm) {
                    DevExpress.ui.notify("New password and confirmation don't match.", "warning", 2500);
                    confirmPwInst.focus();
                    return;
                }

                $("#currentPwVal").val(current);
                $("#newPwVal").val(next);
                $("#confirmPwVal").val(confirm);
                document.getElementById("changePwForm").submit();
            }
        });
    </script>
</body>
</html>
