@{
    ViewData["Title"] = "Quick add crash record";
}

<style>
    .qa-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #c8d4e6;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        padding: 24px;
        max-width: 820px;
    }

    .qa-note {
        background: #e6f1fb;
        border: 1px solid #b5d4f4;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: .8rem;
        color: #0c447c;
        margin-bottom: 20px;
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .qa-section-title {
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .7px;
        color: #192b45;
        font-weight: 700;
        margin: 20px 0 10px;
    }

    .qa-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 12px;
    }

    .qa-field label {
        font-size: .72rem;
        color: #666;
        display: block;
        margin-bottom: 4px;
    }

    .qa-vehicle-card {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #c8d4e6;
        border-radius: 8px;
        padding: 8px 12px;
        margin-bottom: 8px;
        background: #f9fafc;
    }

    .qa-vehicle-badge {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #192b45;
        color: #fff;
        font-size: .72rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .qa-casualty-grid {
        display: grid;
        grid-template-columns: 90px repeat(4, 1fr);
        gap: 6px;
        margin-bottom: 16px;
    }

        .qa-casualty-grid .qa-col-header {
            text-align: center;
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .4px;
            color: #888;
            font-weight: 700;
        }

        .qa-casualty-grid .qa-row-header {
            font-size: .78rem;
            font-weight: 700;
            display: flex;
            align-items: center;
        }

    .qa-row-header.fatal {
        color: #b71c1c;
    }

    .qa-row-header.serious {
        color: #a15c00;
    }

    .qa-row-header.slight {
        color: #555;
    }

    .qa-stepper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        border-radius: 6px;
        padding: 4px;
    }

        .qa-stepper.fatal {
            background: #ffebee;
        }

        .qa-stepper.serious {
            background: #fff3e0;
        }

        .qa-stepper.slight {
            background: #f5f5f5;
        }

    .qa-stepper-count {
        width: 22px;
        text-align: center;
        font-size: .85rem;
        font-weight: 700;
    }

    .qa-stepper.fatal .qa-stepper-count {
        color: #b71c1c;
    }

    .qa-stepper.serious .qa-stepper-count {
        color: #a15c00;
    }

    .qa-stepper-btn {
        width: 24px;
        height: 24px;
        border: 1px solid #ccc;
        background: #fff;
        border-radius: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: .8rem;
        line-height: 1;
        padding: 0;
    }

        .qa-stepper-btn:hover {
            background: #f0f0f0;
        }

    .qa-person-row {
        display: grid;
        grid-template-columns: 130px 1.3fr 1fr 70px 1fr 32px;
        gap: 8px;
        align-items: center;
        margin-bottom: 6px;
        padding: 6px 10px;
        border-radius: 6px;
        border-left: 3px solid transparent;
    }

        .qa-person-row.fatal {
            background: #ffebee;
            border-left-color: #b71c1c;
        }

        .qa-person-row.serious {
            background: #fff3e0;
            border-left-color: #e65100;
        }

        .qa-person-row.slight {
            background: #f5f5f5;
            border-left-color: #999;
        }

    .qa-person-label {
        font-size: .74rem;
        font-weight: 700;
    }

    .qa-person-row.fatal .qa-person-label {
        color: #b71c1c;
    }

    .qa-person-row.serious .qa-person-label {
        color: #a15c00;
    }

    .qa-person-row.slight .qa-person-label {
        color: #555;
    }

    .qa-person-remove {
        width: 28px;
        height: 28px;
        border: none;
        background: transparent;
        color: #b71c1c;
        cursor: pointer;
        font-size: .95rem;
    }

    .qa-inline-buttons {
        display: flex;
        gap: 10px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    /* Page-level polish: these rules keep all existing DevExtreme editors and
       reorganise their surrounding layout to match the application shell. */
    .qa-page { max-width:1180px; margin:0 auto; }
    .qa-hero { margin-bottom:1rem; }
    .qa-eyebrow { color:var(--g-600); font:600 .66rem 'DM Mono',monospace; letter-spacing:1.2px; text-transform:uppercase; margin-bottom:.4rem; }
    .qa-hero h1 { margin:0 0 .35rem; color:#171d25; font-size:1.65rem; }
    .qa-layout { display:block; }
    .qa-card { max-width:none; padding:0; border-color:#dce0e7; border-radius:12px; box-shadow:0 7px 24px rgba(12, 18, 28, .055); overflow:hidden; }
    .qa-note { margin:0; border:0; border-bottom:1px solid #dce1e8; border-radius:0; padding:13px 20px; color:#3c4859; background:#f3f5f8; line-height:1.45; }
    .qa-form-body { padding:2px 22px 22px; }
    .qa-section-title { display:flex; align-items:center; gap:.65rem; margin:22px 0 12px; color:#273d5f; }
    .qa-section-title::after { content:''; height:1px; flex:1; background:#e3e6eb; }
    .qa-row { gap:14px; margin-bottom:14px; }
    .qa-field label { color:#565c64; font-weight:600; }
    .qa-field label .required { color:#b4493d; }
    .qa-card .dx-texteditor { border-color:#d6dae1; border-radius:7px; background:#fff; }
    .qa-card .dx-texteditor.dx-state-focused { border-color:#699ba7; box-shadow:0 0 0 2px rgba(46, 71, 109, .10); }
    .qa-vehicle-card { padding:11px 12px; border-color:#dce0e7; background:#fafbfc; border-radius:9px; }
    .qa-vehicle-badge { border-radius:8px; width:30px; height:30px; background:#eaeef3; color:#192b45; font-family:'DM Mono',monospace; }
    .qa-casualty-grid { padding:12px; border:1px solid #e0e3e8; border-radius:9px; background:#fafbfc; }
    .qa-stepper { min-height:38px; }
    .qa-stepper .dx-button { width:25px; height:25px; min-width:25px; border-radius:6px; }
    .qa-stepper .dx-button-content { padding:0; }
    .qa-person-row { border-radius:8px; padding:8px 10px; }
    .qa-savebar { display:flex; align-items:center; gap:10px; padding-top:4px; }
    .qa-savebar::after { content:'Required fields are checked before saving'; margin-left:auto; color:#89938c; font-size:.68rem; }
    @@media(max-width:700px) { .qa-row { grid-template-columns:1fr; } .qa-casualty-grid { grid-template-columns:75px repeat(4,minmax(54px,1fr)); overflow-x:auto; } .qa-person-row { grid-template-columns:1fr 1fr; } .qa-savebar::after { display:none; } }
</style>

<div class="qa-page">
<header class="qa-hero">
    <div>
        <div class="qa-eyebrow">Crash registry</div>
        <h1>Quick add crash record</h1>
    </div>
</header>
<div class="qa-layout">
<div class="qa-card">
    <div class="qa-form-body">
    <div class="qa-section-title">Identification</div>
    <div class="qa-row">
        <div class="qa-field"><label>CR number <span class="required">*</span></label><div id="crNoBox"></div></div>
        <div class="qa-field"><label>CAS number</label><div id="casNoBox"></div></div>
        <div class="qa-field"><label>District</label><div id="districtBox"></div></div>
    </div>
    <div class="qa-row">
        <div class="qa-field"><label>Station <span class="required">*</span></label><div id="stationBox"></div></div>
        <div class="qa-field"><label>Route</label><div id="routeBox"></div></div>
        <div class="qa-field"><label>Location</label><div id="locationBox"></div></div>
    </div>

    <div class="qa-section-title">Crash details</div>
    <div class="qa-row">
        <div class="qa-field"><label>Date</label><div id="crashDateBox"></div></div>
        <div class="qa-field"><label>Time</label><div id="crashTimeBox"></div></div>
        <div class="qa-field"><label>Crash type</label><div id="crashTypeBox"></div></div>
    </div>

    <div class="qa-section-title">Vehicles</div>
    <div id="vehicleCards"></div>
    <div id="btnAddVehicle" style="margin-bottom: 20px;"></div>

    <div class="qa-section-title">Casualties</div>
    <div class="qa-casualty-grid" id="casualtyGrid">
        <div></div>
        <div class="qa-col-header">Driver</div>
        <div class="qa-col-header">Passenger</div>
        <div class="qa-col-header">Pedestrian</div>
        <div class="qa-col-header">Cyclist</div>
    </div>

    <div id="personRows"></div>

    <div class="qa-section-title" style="margin-top: 28px;">Save</div>
    <div class="qa-savebar">
        <div id="btnSave" style="min-width:140px;"></div>
        <div id="btnCancel" style="min-width:100px;"></div>
    </div>
    </div>
</div>

</div>
</div>

@section Scripts {
    <script>
        $(function () {

            var data = {
                CrNo: null, CasNo: null, District: null, Station: null,
                CrashDate: null, CrashTime: null, CrashType: null,
                Route: null, Location: null
            };

            var vehicles = [];       // { VehicleNumber, VehicleTypeCode, VehicleTypeName, Registration }
            var personRows = [];     // { Severity, Role, VehicleNumber, Age, Gender, Race, _row, _widgets }
            var nextVehicleNumber = 1;
            var vehicleTypeOptions = [];

            var SEVERITIES = ["Fatal", "Serious", "Slight"];
            var ROLES = ["Driver", "Passenger", "Pedestrian", "Cyclist"];

            function severityClass(s) { return s.toLowerCase(); }

            function textBox(container, placeholder, onChange) {
                return $(container).dxTextBox({
                    placeholder: placeholder, showClearButton: true,
                    onValueChanged: function (e) { if (onChange) onChange(e.value); }
                }).dxTextBox("instance");
            }

            // ── Identification / crash detail fields ────────────────────
            textBox("#crNoBox", "e.g. TONGA-01/09/2026", function (v) { data.CrNo = v; });
            textBox("#casNoBox", "e.g. CAS-2026-1234", function (v) { data.CasNo = v; });

            // FIX: /api/lookup/districts returns a plain array of strings,
            // not {text: ...} objects like most other lookup endpoints --
            // confirmed against the one other place in this project that
            // already consumes this same endpoint successfully (it passes
            // the raw array straight to items with no displayExpr/valueExpr
            // at all). Specifying displayExpr/valueExpr: "text" here was
            // looking for a property that doesn't exist on a plain string,
            // which is why every entry showed blank.
            $("#districtBox").dxSelectBox({
                dataSource: { load: function () { return $.getJSON("/api/lookup/districts"); } },
                searchEnabled: true, showClearButton: true,
                onValueChanged: function (e) { data.District = e.value; }
            });

            // FIX: Station/Route/Location no longer gated behind selecting
            // a district first -- all fields are visible together from
            // the start.
            $("#stationBox").dxSelectBox({
                dataSource: { load: function (o) { return $.getJSON("/api/lookup/stations", { q: o.searchValue }); } },
                displayExpr: "text", valueExpr: "text",
                searchEnabled: true, acceptCustomValue: true, showClearButton: true,
                onValueChanged: function (e) { data.Station = e.value; }
            });

            $("#crashDateBox").dxDateBox({
                type: "date", displayFormat: "dd/MM/yyyy", value: new Date(),
                onValueChanged: function (e) { data.CrashDate = e.value ? e.value.toISOString().split("T")[0] : null; }
            });
            $("#crashTimeBox").dxDateBox({
                type: "time", displayFormat: "HH:mm", pickerType: "rollers", useMaskBehavior: true,
                onValueChanged: function (e) {
                    data.CrashTime = e.value
                        ? e.value.getHours().toString().padStart(2, "0") + ":" + e.value.getMinutes().toString().padStart(2, "0")
                        : null;
                }
            });
            $("#crashTypeBox").dxSelectBox({
                dataSource: { load: function (o) { return $.getJSON("/api/lookup/crashtypes", { q: o.searchValue }); } },
                displayExpr: "text", valueExpr: "text",
                searchEnabled: true, acceptCustomValue: true, showClearButton: true,
                onValueChanged: function (e) { data.CrashType = e.value; }
            });
            $("#routeBox").dxSelectBox({
                dataSource: { load: function (o) { return $.getJSON("/api/lookup/routes", { q: o.searchValue }); } },
                displayExpr: "text", valueExpr: "text",
                searchEnabled: true, acceptCustomValue: true, showClearButton: true,
                onValueChanged: function (e) { data.Route = e.value; }
            });
            $("#locationBox").dxSelectBox({
                dataSource: { load: function (o) { return $.getJSON("/api/lookup/locations", { q: o.searchValue }); } },
                displayExpr: "text", valueExpr: "text",
                searchEnabled: true, acceptCustomValue: true, showClearButton: true,
                onValueChanged: function (e) { data.Location = e.value; }
            });

            // ── Vehicles (instance-based) ────────────────────────────────
            function refreshVehicleDropdowns() {
                var items = vehicles.map(function (v) {
                    return { value: v.VehicleNumber, text: "Vehicle " + v.VehicleNumber + " — " + (v.VehicleTypeName || "?") };
                });
                personRows.forEach(function (p) {
                    if (!p._widgets || !p._widgets.vehicle) return;
                    p._widgets.vehicle.option("items", items);
                    if (p.VehicleNumber !== null && !items.some(function (i) { return i.value === p.VehicleNumber; })) {
                        p.VehicleNumber = null;
                        p._widgets.vehicle.option("value", null);
                    }
                });
            }

            function addVehicleCard() {
                var num = nextVehicleNumber++;
                var entry = { VehicleNumber: num, VehicleTypeCode: null, VehicleTypeName: null, Registration: null };
                vehicles.push(entry);

                var card = $("<div class='qa-vehicle-card'>").appendTo("#vehicleCards");
                $("<div class='qa-vehicle-badge'>").text(num).appendTo(card);

                var typeDiv = $("<div style='flex:1;'>").appendTo(card);
                typeDiv.dxSelectBox({
                    items: vehicleTypeOptions, displayExpr: "text", valueExpr: "value",
                    placeholder: "Vehicle type...", searchEnabled: true,
                    onValueChanged: function (e) {
                        entry.VehicleTypeCode = e.value;
                        var match = vehicleTypeOptions.find(function (o) { return o.value === e.value; });
                        entry.VehicleTypeName = match ? match.text : null;
                        refreshVehicleDropdowns();
                    }
                });

                var regDiv = $("<div style='flex:1;'>").appendTo(card);
                regDiv.dxTextBox({
                    placeholder: "Registration (optional)",
                    onValueChanged: function (e) { entry.Registration = e.value; }
                });


                $("<div>").appendTo(card).dxButton({
                    icon: "trash", hint: "Remove vehicle", type: "danger", stylingMode: "text",
                    onClick: function () {
                    var idx = vehicles.indexOf(entry);
                    if (idx > -1) vehicles.splice(idx, 1);
                    card.remove();

                    var affected = personRows.filter(function (p) { return p.VehicleNumber === num; });
                    if (affected.length > 0) {
                        affected.forEach(function (p) {
                            p.VehicleNumber = null;
                            if (p._widgets && p._widgets.vehicle) p._widgets.vehicle.option("value", null);
                        });
                        DevExpress.ui.notify(
                            affected.length + " casualty entr" + (affected.length === 1 ? "y was" : "ies were") +
                            " linked to that vehicle — vehicle selection cleared, please reassign.",
                            "warning", 4500
                        );
                    }
                    refreshVehicleDropdowns();
                    }
                });
            }

            $.getJSON("/api/lookup/vehicletypes").done(function (items) {
                vehicleTypeOptions = (items || []).map(function (i) {
                    return { value: i.value, text: i.text };
                });
                addVehicleCard(); 
            });

            $("#btnAddVehicle").dxButton({
                text: "Add vehicle", icon: "plus", type: "normal", stylingMode: "outlined",
                onClick: addVehicleCard
            });

            
            var stepperWidgets = {}; 

            function groupKey(sev, role) { return sev + ":" + role; }

            function countFor(sev, role) {
                return personRows.filter(function (p) { return p.Severity === sev && p.Role === role; }).length;
            }

            function syncStepperDisplay(sev, role) {
                var w = stepperWidgets[groupKey(sev, role)];
                if (w) w.countEl.text(countFor(sev, role));
            }

            function addPersonRow(sev, role) {
                var entry = { Severity: sev, Role: role, VehicleNumber: null, Age: null, Gender: null, Race: null, _widgets: {} };
                personRows.push(entry);

                var cls = severityClass(sev);
                var row = $("<div class='qa-person-row " + cls + "'>").appendTo("#personRows");

                $("<div class='qa-person-label'>").text(sev + " · " + role).appendTo(row);

                var vehicleDiv = $("<div>").appendTo(row);
                var noVehicle = (role === "Pedestrian" || role === "Cyclist");
                entry._widgets.vehicle = vehicleDiv.dxSelectBox({
                    items: vehicles.map(function (v) { return { value: v.VehicleNumber, text: "Vehicle " + v.VehicleNumber + " — " + (v.VehicleTypeName || "?") }; }),
                    displayExpr: "text", valueExpr: "value",
                    placeholder: noVehicle ? "No vehicle" : "Which vehicle?",
                    disabled: noVehicle,
                    onValueChanged: function (e) { entry.VehicleNumber = e.value; }
                }).dxSelectBox("instance");

                var genderDiv = $("<div>").appendTo(row);
                genderDiv.dxSelectBox({
                    items: [{ text: "M", value: "M" }, { text: "F", value: "F" }],
                    displayExpr: "text", valueExpr: "value", placeholder: "Gender",
                    onValueChanged: function (e) { entry.Gender = e.value; }
                });

                var ageDiv = $("<div>").appendTo(row);
                ageDiv.dxNumberBox({
                    placeholder: "Age", min: 0, max: 120,
                    onValueChanged: function (e) { entry.Age = e.value; }
                });

                var raceDiv = $("<div>").appendTo(row);
                raceDiv.dxSelectBox({
                    items: [
                        { text: "African (B)", value: "B" }, { text: "Coloured (C)", value: "C" },
                        { text: "Indian (I)", value: "I" }, { text: "White (W)", value: "W" }, { text: "Other (O)", value: "O" }
                    ],
                    displayExpr: "text", valueExpr: "value", placeholder: "Race",
                    onValueChanged: function (e) { entry.Race = e.value; }
                });

                $("<div>").appendTo(row).dxButton({
                    icon: "trash", hint: "Remove casualty", type: "danger", stylingMode: "text",
                    onClick: function () {
                    var hasData = entry.Age !== null || entry.Gender || entry.Race || entry.VehicleNumber !== null;
                    if (hasData && !confirm("This entry has details filled in. Remove it anyway?")) return;
                    var idx = personRows.indexOf(entry);
                    if (idx > -1) personRows.splice(idx, 1);
                    row.remove();
                    syncStepperDisplay(sev, role);
                    }
                });

                entry._row = row;
                syncStepperDisplay(sev, role);
            }

            function removeLastPersonRow(sev, role) {
                for (var i = personRows.length - 1; i >= 0; i--) {
                    var p = personRows[i];
                    if (p.Severity === sev && p.Role === role) {
                        var hasData = p.Age !== null || p.Gender || p.Race || p.VehicleNumber !== null;
                        if (hasData && !confirm("The last " + sev.toLowerCase() + " " + role.toLowerCase() +
                            " entry has details filled in. Remove it anyway?")) return false;
                        p._row.remove();
                        personRows.splice(i, 1);
                        return true;
                    }
                }
                return false;
            }

            SEVERITIES.forEach(function (sev) {
                var rowHeader = $("<div class='qa-row-header " + severityClass(sev) + "'>").text(sev).appendTo("#casualtyGrid");
                ROLES.forEach(function (role) {
                    var cell = $("<div class='qa-stepper " + severityClass(sev) + "'>").appendTo("#casualtyGrid");
                    var minusBtn = $("<div>").appendTo(cell);
                    var countEl = $("<span class='qa-stepper-count'>").text("0").appendTo(cell);
                    var plusBtn = $("<div>").appendTo(cell);

                    stepperWidgets[groupKey(sev, role)] = { countEl: countEl };

                    plusBtn.dxButton({ icon:"plus", hint:"Add " + sev.toLowerCase() + " " + role.toLowerCase(), stylingMode:"outlined", onClick:function () { addPersonRow(sev, role); } });
                    minusBtn.dxButton({ icon:"minus", hint:"Remove last " + sev.toLowerCase() + " " + role.toLowerCase(), stylingMode:"outlined", onClick:function () { removeLastPersonRow(sev, role); syncStepperDisplay(sev, role); } });
                });
            });

            
            $("#btnSave").dxButton({
                text: "Save record",
                type: "default",
                icon: "save",
                onClick: function () {
                    if (!data.Station) {
                        DevExpress.ui.notify("Please select a district and station.", "warning", 3000);
                        return;
                    }
                    if (!data.CrNo) {
                        DevExpress.ui.notify("CR number is required.", "warning", 3000);
                        return;
                    }

                    var incompleteVehicles = vehicles.filter(function (v) { return !v.VehicleTypeCode; });
                    if (incompleteVehicles.length > 0) {
                        DevExpress.ui.notify("Every vehicle needs a type selected.", "error", 4000);
                        return;
                    }

                    var crashDate = data.CrashDate;
                    if (!crashDate) {
                        var today = new Date();
                        crashDate = today.getFullYear() + "-" + String(today.getMonth() + 1).padStart(2, "0") + "-" + String(today.getDate()).padStart(2, "0");
                    }
                    var crashTime = data.CrashTime || "00:00";

                    var cleanVehicles = vehicles.map(function (v) {
                        return { VehicleNumber: v.VehicleNumber, VehicleTypeCode: v.VehicleTypeCode, VehicleTypeName: v.VehicleTypeName, Registration: v.Registration };
                    });
                    var cleanPersonRows = personRows.map(function (p) {
                        return { Severity: p.Severity, Role: p.Role, VehicleNumber: p.VehicleNumber, Age: p.Age, Gender: p.Gender, Race: p.Race };
                    });

                    var payload = {
                        CrNo: data.CrNo || "",
                        CasNo: data.CasNo || "",
                        Station: data.Station || "",
                        Route: data.Route || "",
                        Location: data.Location || "",
                        CrashType: data.CrashType || "",
                        CrashDate: crashDate,
                        CrashTime: crashTime,
                        vehiclesJson: JSON.stringify(cleanVehicles),
                        injuriesJson: JSON.stringify(cleanPersonRows)
                    };

                    $.post("/CreateSummary/CreateSummary", $.extend({
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                    }, payload))
                    .done(function (res) {
                        if (res.success) {
                            DevExpress.ui.notify(res.message + " (CR number: " + res.crNo + ")", "success", 4000);
                            window.location.href = "/Crashes";
                        } else {
                            DevExpress.ui.notify(res.message, "error", 4000);
                        }
                    })
                    .fail(function (jqXHR) {
                        var msg = "Something went wrong. Please try again.";
                        if (jqXHR.responseJSON && jqXHR.responseJSON.message) msg = jqXHR.responseJSON.message;
                        else if (jqXHR.responseText) msg = jqXHR.responseText;
                        DevExpress.ui.notify(msg, "error", 5000);
                        console.error("Server error:", jqXHR.responseText);
                    });
                }
            });

            $("#btnCancel").dxButton({
                text: "Cancel",
                stylingMode: "outlined",
