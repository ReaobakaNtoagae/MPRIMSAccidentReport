                typeInst.option("items", types);
                typeInst.option("value", null);
            });

            var typeWrap = $("<div>").appendTo(row);
            $("<div class='field-label'>").text("Vehicle Type").appendTo(typeWrap);
            var typeDiv = $("<div>").appendTo(typeWrap);
