                    .attr("id","pTab-"+index)
                    .text("Person " + (index+1))
                    .on("click",function(){
                        $(".entry-tab").removeClass("active");
                        $(".entry-form").removeClass("active");
                        $(this).addClass("active");
                        $("#pForm-"+index).addClass("active");
                    });

                $("#personTabs").append(tab);

                var fd = $("<div>")
                    .addClass("entry-form" + (index===0 ? " active":""))
                    .attr("id","pForm-"+index)
                    .appendTo("#personForms");

                buildPersonInformation(fd,data);
                buildPersonCrashInformation(fd,data);
                buildPersonMedical(fd,data);
                buildPersonAddress(fd,data);
                buildPedestrianDetails(fd,data);
            }

            function buildPersonInformation(fd,data){
                sec(fd,"Personal Information");

                var row=$("<div class='field-row cols-4'>").appendTo(fd);

                [
                    ["Surname","text",v=>data.Surname=v],
                    ["Full Names","text",v=>data.FullNames=v],
                    ["ID Type", "sel", formOptions.IdType, v => data.IdType = v],
                    ["ID Number","text",v=>data.IdNumber=v],
                    ["Age","number",v=>data.Age=v],
                    ["Gender","sel", formOptions.Gender, v=>data.Gender=v],
                    ["Nationality","text", v=>data.Nationality=v],
                    ["Population Group","sel", formOptions.PopulationGroup, v=>data.PopulationGroup=v],
                    ["Occupation","text", v=>data.Occupation=v]
                ]
                .forEach(function(f){
                    var w=$("<div>").appendTo(row);
                    $("<div class='field-label'>").text(f[0]).appendTo(w);
                    if(f[1]=="sel") staticSelect($("<div>").appendTo(w),f[2],f[0],f[3]);
                    else if(f[1]=="number") numberBox($("<div>").appendTo(w),null,0,f[2]);
                    else textBox($("<div>").appendTo(w),f[0],f[2]);
                });
            }

            function buildPersonCrashInformation(fd, data) {
                sec(fd, "Crash Information");

                var row = $("<div class='field-row cols-4'>").appendTo(fd);

                var roleWrap = $("<div>").appendTo(row);
                $("<div class='field-label'>").text("Role").appendTo(roleWrap);
                var roleDiv = $("<div>").appendTo(roleWrap);


                var roleInst = staticSelect(roleDiv,
                    ["Passenger", "Pedestrian", "Bicyclist", "Motorcyclist", "Passenger on Motorcycle", "Other"],
                    "Select role...",
                    function(val) {
                        data.Role = val;
                        if (data._pedestrianContainer) {
                            var show = (val === "Pedestrian" || val === "Bicyclist");
                            data._pedestrianContainer.toggle(show);
                        }
                    }
                );

                var otherFields = [
                    ["Vehicle Reference", "sel", formOptions.VehicleReference, v => data.VehicleReference = v],
                    ["Seating Position", "sel", formOptions.SeatingPosition, v => data.SeatingPosition = v],
                    ["Injury Severity", "sel", fixedValues.InjurySeverity, v => data.SeverityOfInjury = v],
                    ["Seatbelt / Helmet", "sel", formOptions.SeatbeltHelmetOption, v => data.SeatbeltHelmet = v],
                    ["Child Restraint", "sel", formOptions.ChildRestraintOption, v => data.ChildRestraint = v]
                ];

                otherFields.forEach(function(f) {
                    var w = $("<div>").appendTo(row);
                    $("<div class='field-label'>").text(f[0]).appendTo(w);
                    staticSelect($("<div>").appendTo(w), f[2], f[0], f[3]);
                });
            }

            function buildPersonMedical(fd,data){
                sec(fd,"Medical Information");

                var row=$("<div class='field-row cols-4'>").appendTo(fd);

                [
                    ["Hospital","text", v=>data.Hospital=v],
                    ["Hospital Reference","text", v=>data.HospitalReference=v],
                    ["Ambulance Reference","text", v=>data.AmbulanceReference=v],
                    ["Medical Practitioner","text", v=>data.Doctor=v]
                ]
                .forEach(function(f){
                    var w=$("<div>").appendTo(row);
                    $("<div class='field-label'>").text(f[0]).appendTo(w);
                    textBox($("<div>").appendTo(w), f[0], f[2]);
                });
            }

            function buildPersonAddress(fd,data){
                sec(fd,"Contact Details");

                var row=$("<div class='field-row cols-4'>").appendTo(fd);

                [
                    ["Home Address","text", v=>data.HomeAddress=v],
                    ["Postal Address","text", v=>data.PostalAddress=v],
                    ["Telephone","text", v=>data.Telephone=v],
                    ["Cell Phone","text", v=>data.CellPhone=v],
                    ["Email","text", v=>data.Email=v]
                ]
                .forEach(function(f){
                    var w=$("<div>").appendTo(row);
                    $("<div class='field-label'>").text(f[0]).appendTo(w);
                    textBox($("<div>").appendTo(w), f[0], f[2]);
                });
            }

            function buildPedestrianDetails(fd, data) {
                var container = $("<div>").css({ display: "none" }).appendTo(fd);

                sec(container, "Pedestrian / Bicyclist Details");

                var row = $("<div class='field-row cols-4'>").appendTo(container);

                [
                    ["Position on Road", "sel", formOptions.PedestrianPositionOnRoad, v => data.PositionOnRoad = v],
                    ["Location re Crossing", "sel", formOptions.PedestrianLocationReCrossing, v => data.LocationReCrossing = v],
                    ["Manoeuvre", "sel", formOptions.PedestrianManoeuvre, v => data.Manoeuvre = v],
                    ["Pedestrian Action", "sel", formOptions.PedestrianAction, v => data.PedestrianAction = v],
                    ["Clothing Colour", "sel", formOptions.ClothingColour, v => data.ClothingColour = v]
                ]
                .forEach(function(f) {
                    var w = $("<div>").appendTo(row);
                    $("<div class='field-label'>").text(f[0]).appendTo(w);
                    if (f[1] == "sel") staticSelect($("<div>").appendTo(w), f[2], f[0], f[3]);
                    else textBox($("<div>").appendTo(w), f[0], f[2]);
                });

                data._pedestrianContainer = container;
            }

            $("#btnAddPerson").dxButton({
                text:"Add Person", type:"default", icon:"plus",
                onClick: function() { buildPersonForm(personCount++); }
            });

            // Separate, lightweight capture for passengers who were not
            // hurt at all -- matches the physical form's own choice to
            // treat this as a distinct, much shorter section (Surname,
            // ID, phone, vehicle -- nothing else) rather than a collapsed
            // version of the full injured-person form above.
            var uninjuredCount = 0;

            function buildUninjuredRow(index) {
                var data = {};
                formData.UninjuredPassengers[index] = data;

                var row = $("<div class='field-row cols-4'>")
                    .css({ borderBottom: "1px solid #eee", paddingBottom: "10px", marginBottom: "10px" })
                    .appendTo("#uninjuredRows");

                [
                    ["Surname & Initials", "text", v => data.Surname = v],
                    ["ID Number", "text", v => data.IdNumber = v],
                    ["Cell / Phone", "text", v => data.CellPhone = v],
                    ["Vehicle Reference", "sel", formOptions.VehicleReference, v => data.VehicleReference = v]
                ]
                .forEach(function(f){
                    var w = $("<div>").appendTo(row);
                    $("<div class='field-label'>").text(f[0]).appendTo(w);
                    if (f[1] == "sel") staticSelect($("<div>").appendTo(w), f[2], f[0], f[3]);
                    else textBox($("<div>").appendTo(w), f[0], f[2]);
                });
            }

            $("#btnAddUninjured").dxButton({
                text: "Add Passenger", type: "default", icon: "plus",
                onClick: function() { buildUninjuredRow(uninjuredCount++); }
            });

            function addFactorRow() {
                var data = { FactorCategory: null, FactorDescription: null, IsMajorFactor: false };
                factorRows.push(data);
                formData.Factors = factorRows;

                var row = $("<div>").css({ display:"grid", gridTemplateColumns:"180px 1fr 160px 40px",
                    gap:"8px", alignItems:"center", marginBottom:"8px" }).appendTo("#factorsGrid");

                var catDiv  = $("<div>").appendTo(row);
                var descDiv = $("<div>").appendTo(row);
                var majDiv  = $("<div>").appendTo(row);
                var delDiv  = $("<div>").appendTo(row);

                var descInst = descDiv.dxSelectBox({
                    items: [], searchEnabled:true, placeholder: "Select category first...",
                    onValueChanged: function(e) { data.FactorDescription = e.value; }
                }).dxSelectBox("instance");

                catDiv.dxSelectBox({
                    items: Object.keys(factorMap), placeholder: "Category...",
                    onValueChanged: function(e) {
                        data.FactorCategory = e.value;
                        descInst.option("items", factorMap[e.value] || []);
                        descInst.option("value", null);
                    }
                });

                majDiv.dxCheckBox({
                    text: "Major factor",
                    onValueChanged: function(e) {
                        if (e.value) factorRows.forEach(function(f){ f.IsMajorFactor = false; });
                        data.IsMajorFactor = e.value;
                    }
                });

                delDiv.dxButton({
                    icon:"trash", type:"danger", stylingMode:"outlined",
                    onClick: function() {
                        var idx = factorRows.indexOf(data);
                        if (idx > -1) factorRows.splice(idx, 1);
                        row.remove();
                    }
                });
            }

            $("#btnAddFactor").dxButton({ text:"Add Factor", type:"default", icon:"plus", onClick: addFactorRow });

            function rv(label, value) {
                return '<div class="review-item"><div class="r-label">' + label +
                       '</div><div class="r-value">' + (value || "—") + '</div></div>';
            }

            var witnessCount = 0;

            function buildWitnessForm(index){
                var data = {};
                formData.Witnesses[index] = data;

                var tab = $("<div>")
                    .addClass("entry-tab" + (index==0 ? " active":""))
                    .text("Witness " + (index+1))
                    .on("click",function(){
                        $("#witnessTabs .entry-tab").removeClass("active");
                        $("#witnessForms .entry-form").removeClass("active");
                        $(this).addClass("active");
                        form.addClass("active");
                    });

                $("#witnessTabs").append(tab);

                var form = $("<div>")
                    .addClass("entry-form" + (index==0 ? " active":""))
                    .appendTo("#witnessForms");

                var row = $("<div class='field-row cols-4'>").appendTo(form);

                [
                    ["Surname Initials", "text", v => data.SurnameInitials = v],
                    ["ID Type","sel", formOptions.IdType, v => data.DriverIdType = v],
                    ["ID Number", "text", v => data.IdNumber = v],
                    ["Cell Phone", "text", v => data.CellPhone = v],
                    ["Other Phone", "text", v => data.OtherPhone = v],
                    ["Work Contact Address", "text", v => data.WorkContactAddress = v]
                ]
                .forEach(function(f){
                    var w=$("<div>").appendTo(row);
                    $("<div class='field-label'>").text(f[0]).appendTo(w);
                    if(f[1]=="sel") staticSelect($("<div>").appendTo(w),f[2],f[0],f[3]);
                    else textBox($("<div>").appendTo(w),f[0],f[2]);
                });
            }

            $("#btnAddWitness").dxButton({
                text: "Add Witness", icon:"plus", type:"default",
                onClick:function(){ buildWitnessForm(witnessCount++); }
            });

            function buildReview() {
                var ci = formData.CrashInfo,
                    lo = formData.Location,
                    co = formData.Conditions,
                    ou = formData.OfficialUse,
                    att = formData.Attachments;

                var html = '<div class="review-section"><h6>Crash Info</h6><div class="review-grid">' +
                    rv("SAPS Station", ci.SapsStation) + rv("CR No.", ci.CrNo) +
                    rv("CAS No.", ci.CasNo) + rv("Date", ci.CrashDate) +
                    rv("Time", ci.CrashTime) + rv("Province", ci.ProvinceCode) +
                    rv("Route", ci.RoadNumber) + '</div></div>';

                html += '<div class="review-section"><h6>Location</h6><div class="review-grid">' +
                    rv("Street", lo.StreetRoadName) + rv("Suburb", lo.Suburb) +
                    rv("City/Town", lo.CityTown) + rv("Junction", lo.JunctionType) +
                    rv("Surface", lo.RoadSurfaceCondition) + '</div></div>';

                html += '<div class="review-section"><h6>Conditions</h6><div class="review-grid">' +
                    rv("Light", co.LightCondition) + rv("Crash Type", co.CrashType) +
                    rv("Weather", co.WeatherConditions.join(", ") || "—") +
                    rv("Hit & Run", co.HitAndRun === true ? "Yes" : co.HitAndRun === false ? "No" : "—") +
                    '</div></div>';

                formData.Vehicles.forEach(function(v, i) {
                    html += '<div class="review-section"><h6>Vehicle ' + (v.VehicleReference || formOptions.VehicleReference[i]) +
                        '</h6><div class="review-grid">' +
                        rv("Reg No.", v.LicenceDiscNumber) + rv("Make", v.Make) +
                        rv("Model", v.Model) + rv("Driver", v.DriverSurname) +
                        rv("Manoeuvre", v.VehicleManoeuvre) + rv("Injury", v.SeverityOfInjury) +
                        '</div></div>';
                });

                if (formData.Persons.length > 0) {
                    html += '<div class="review-section"><h6>Persons</h6><div class="review-grid">';
                    formData.Persons.forEach(function(p) {
                        html += rv(p.Role || "Person",
                            (p.Surname||"") + " " + (p.FullNames||"") +
                            (p.SeverityOfInjury ? " — " + p.SeverityOfInjury : ""));
                    });
                    html += '</div></div>';
                }

                if (formData.UninjuredPassengers.length > 0) {
                    html += '<div class="review-section"><h6>Passengers Visibly Not Injured</h6><div class="review-grid">';
                    formData.UninjuredPassengers.forEach(function(p) {
                        html += rv(p.VehicleReference ? "Vehicle " + p.VehicleReference : "Passenger", p.Surname || "");
                    });
                    html += '</div></div>';
                }

                if (factorRows.length > 0) {
                    html += '<div class="review-section"><h6>Contributory Factors</h6><div class="review-grid">';
                    factorRows.forEach(function(f) {
                        html += rv(f.FactorCategory, f.FactorDescription + (f.IsMajorFactor ? " ⭐" : ""));
                    });
                    html += '</div></div>';
                }

                if (ou.CompletedByName || ou.CompletedByRank || ou.ReportStatus) {
                    html += '<div class="review-section"><h6>Official Use</h6><div class="review-grid">' +
                        rv("Completed By", ou.CompletedByName) +
                        rv("Rank", ou.CompletedByRank) +
                        rv("Station", ou.CompletedByStation) +
                        rv("Status", ou.ReportStatus) +
                        rv("Classification", ou.FinalClassification) +
                        rv("Docket #", ou.DocketNumber) +
                        '</div></div>';
                }

                if (att.length > 0) {
                    var fileNames = att.map(function(f) { return f.FileName; }).join(", ");
                    html += '<div class="review-section"><h6>Attachments</h6><div class="review-grid">' +
                        rv("Files", fileNames) +
                        rv("Total", att.length + " files") +
                        rv("Notes", formData.AttachmentNotes) +
                        '</div></div>';
                }

                $("#reviewContent").html(html);
            }

            function goToStep(n) {
                currentStep = n;
                $(".step-panel").removeClass("active");
                $("#panel-" + currentStep).addClass("active");
                buildStepBar();
                updateNavButtons();
                if (currentStep === 10) buildReview();
                window.scrollTo(0, 0);
            }

            function updateNavButtons() {
                $("#btnBack").dxButton("instance").option("visible", currentStep > 1);
                $("#btnNext").dxButton("instance").option(
                    currentStep === totalSteps
                        ? { text:"Submit Report", type:"success", icon:"check" }
                        : { text:"Next", type:"default", icon:"arrowright" }
                );
            }

            $("#btnBack").dxButton({
                text:"Back", type:"normal", icon:"arrowleft", stylingMode:"outlined", visible:false,
                onClick: function() { if (currentStep > 1) goToStep(currentStep - 1); }
            });

            $("#btnNext").dxButton({
                text:"Next", type:"default", icon:"arrowright",
                onClick: function() {
                    if (currentStep < totalSteps) {
                        goToStep(currentStep + 1);
                    } else {
                        formData.Factors = factorRows;
                        $("#formJsonInput").val(JSON.stringify(formData));
                        DevExpress.ui.dialog.confirm(
                            "Are you ready to submit this crash report?", "Confirm Submission"
                        ).then(function(ok) {
                            if (ok) document.getElementById("wizardForm").submit();
                        });
                    }
                }
            });

            buildStepBar();
            updateNavButtons();

            } // end initWizard
        });
    </script>
}
