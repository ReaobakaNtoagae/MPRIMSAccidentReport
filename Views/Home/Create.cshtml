        function buildWitnessForm(index){

            var data = {};

            formData.Witnesses[index] = data;

            var tab = $("<div>")
                .addClass("entry-tab" + (index==0 ? " active":""))
                .text("Witness " + (index+1))
                .on("click",function(){

                    $("#witnessTabs .entry-tab").removeClass("active");
                    $("#witnessForms .entry-form").removeClass("active");

                    $(this).addClass("active");
                    form.addClass("active");

                });

            $("#witnessTabs").append(tab);

            var form = $("<div>")
                .addClass("entry-form" + (index==0 ? " active":""))
                .appendTo("#witnessForms");

            var row = $("<div class='field-row cols-4'>").appendTo(form);

            [
                ["Surname Initials", "text", v => data.SurnameInitials = v],
                ["ID Number", "text", v => data.IdNumber = v],
                ["Cell Phone", "text", v => data.CellPhone = v],
                ["Other Phone", "text", v => data.OtherPhone = v],
                ["Work Contact Address", "text", v => data.WorkContactAddress = v]
            ]
            .forEach(function(f){

                var w=$("<div>").appendTo(row);

                $("<div class='field-label'>")
                    .text(f[0])
                    .appendTo(w);

                if(f[1]=="sel")
                    staticSelect($("<div>").appendTo(w),f[2],f[0],f[3]);
                else
                    textBox($("<div>").appendTo(w),f[0],f[2]);

            });

        }

