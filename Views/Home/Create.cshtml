    @{
        ViewData["Title"] = "New CR1 Crash Report";
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong>
            <div style="white-space: pre-line;">@TempData["ErrorMessage"]</div>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }


    <form id="wizardForm" method="post" asp-action="Submit">
        @Html.AntiForgeryToken()
        <input type="hidden" id="formJsonInput" name="formJson" />
    </form>

    <style>
        .wizard-steps {
            display: flex;
            align-items: center;
            margin-bottom: 28px;
            background: #fff;
            border-radius: 10px;
            padding: 18px 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
            border: 1px solid #c8e6c9;
            overflow-x: auto;
        }

        .step-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
            position: relative;
            min-width: 80px;
        }

            .step-item:not(:last-child)::after {
                content: "";
                position: absolute;
                top: 16px;
                left: 60%;
                width: 80%;
                height: 2px;
                background: #c8e6c9;
                z-index: 0;
            }

            .step-item.completed:not(:last-child)::after {
                background: #2e7d32;
            }

        .step-circle {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 2px solid #c8e6c9;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .82rem;
            font-weight: 700;
            color: #aaa;
            position: relative;
            z-index: 1;
            transition: all .25s;
        }

        .step-item.active .step-circle {
            background: #2e7d32;
            border-color: #2e7d32;
            color: #fff;
        }

        .step-item.completed .step-circle {
            background: #43a047;
            border-color: #43a047;
            color: #fff;
        }

        .step-label {
            margin-top: 6px;
            font-size: .7rem;
            color: #aaa;
            text-align: center;
            font-weight: 500;
            white-space: nowrap;
        }

        .step-item.active .step-label {
            color: #2e7d32;
            font-weight: 700;
        }

        .step-item.completed .step-label {
            color: #43a047;
        }

        .step-panel {
            display: none;
        }

            .step-panel.active {
                display: block;
            }

        .panel-card {
            background: #fff;
            border-radius: 10px;
            padding: 24px 28px 16px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            border: 1px solid #c8e6c9;
            margin-bottom: 16px;
        }

            .panel-card h6 {
                font-size: .78rem;
                text-transform: uppercase;
                letter-spacing: .7px;
                color: #2e7d32;
                font-weight: 700;
                margin-bottom: 16px;
                padding-bottom: 8px;
                border-bottom: 2px solid #e8f5e9;
            }

        .wizard-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fff;
            border-radius: 10px;
            padding: 14px 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
            border: 1px solid #c8e6c9;
        }

        .field-row {
            display: grid;
            gap: 12px;
            margin-bottom: 12px;
        }

            .field-row.cols-4 {
                grid-template-columns: repeat(4, 1fr);
            }

            .field-row.cols-3 {
                grid-template-columns: repeat(3, 1fr);
            }

            .field-row.cols-2 {
                grid-template-columns: repeat(2, 1fr);
            }

        .field-label {
            font-size: .72rem;
            color: #555;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .entry-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .entry-tab {
            padding: 6px 14px;
            border-radius: 20px;
            border: 1px solid #a5d6a7;
            background: #f1f8f1;
            color: #2e7d32;
            font-size: .8rem;
            cursor: pointer;
            font-weight: 600;
        }

            .entry-tab.active {
                background: #2e7d32;
                color: #fff;
                border-color: #2e7d32;
            }

        .entry-form {
            display: none;
        }

            .entry-form.active {
                display: block;
            }

        .review-section {
            margin-bottom: 14px;
        }

            .review-section h6 {
                font-size: .75rem;
                text-transform: uppercase;
                letter-spacing: .6px;
                color: #2e7d32;
                font-weight: 700;
                margin-bottom: 8px;
            }

        .review-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 8px;
        }

        .review-item {
            background: #f1f8f1;
            border-radius: 6px;
            padding: 8px 12px;
            font-size: .8rem;
        }

            .review-item .r-label {
                color: #666;
                margin-bottom: 2px;
                font-size: .72rem;
            }

            .review-item .r-value {
                color: #1b5e20;
                font-weight: 600;
            }
    </style>


