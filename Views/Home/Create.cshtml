                   function buildVehicleForm(index) {

                    var ref = vehicleRefs[index];

                    var data = {
                        VehicleReference: ref,
                        VehicleDamages: []
                    };

                    formData.Vehicles[index] = data;

                    var tab = $("<div>")
                        .addClass("entry-tab" + (index === 0 ? " active" : ""))
                        .attr("id","vTab-" + index)
                        .text("Vehicle " + ref)
                        .on("click",function(){

                            $(".entry-tab").removeClass("active");
                            $(".entry-form").removeClass("active");

                            $(this).addClass("active");
                            $("#vForm-" + index).addClass("active");

                        });

                    $("#vehicleTabs").append(tab);

                    var fd = $("<div>")
                        .addClass("entry-form" + (index===0 ? " active":""))
                        .attr("id","vForm-" + index)
                        .appendTo("#vehicleForms");

                    buildVehicleDetails(fd,data);

                    buildDriverInformation(fd,data);

                    buildDriverLicence(fd,data);

                    buildDriverCrashDetails(fd,data);

                    buildVehicleConduct(fd,data);

                    buildVehicleDamage(fd,data);

                    buildDangerousGoods(fd,data);
                }

            function buildVehicleDetails(fd, data) {

