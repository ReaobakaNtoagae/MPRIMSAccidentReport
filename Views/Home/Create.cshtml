            $("<div class='field-label'>").text("Vehicle Category").appendTo(catWrap);
            var catDiv = $("<div>").appendTo(catWrap);
            var categoryInst = staticSelect(catDiv, Object.keys(vehicleMap), "Select category...", function(val) {
                data.VehicleCategory = val;
