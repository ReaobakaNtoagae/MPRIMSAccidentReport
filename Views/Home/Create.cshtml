            var attachmentFiles = [];

            $("#attachmentUpload").dxFileUploader({
                multiple: true,
                uploadMode: "useForm",
                accept: "image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt",
                maxFileSize: 10485760,
                onValueChanged: function(e) {
                    var files = e.value;
                    if (files && files.length > 0) {
                        for (var i = 0; i < files.length; i++) {
                            var file = files[i];
                            var reader = new FileReader();
                            reader.onload = function(ev) {
                                var fileData = {
                                    FileName: this.name,
                                    FileSize: this.size,
                                    FileType: this.type,
                                    FileData: ev.target.result.split(',')[1],
                                    UploadDate: new Date().toISOString()
                                };
                                attachmentFiles.push(fileData);
                                formData.Attachments = attachmentFiles;
                                updateAttachmentList();
                                updateTotalAttachments();
                            }.bind(file);
                            reader.readAsDataURL(file);
                        }
                    }
                }
            });

            function updateAttachmentList() {
                var container = $("#attachmentList");
                container.empty();

                if (attachmentFiles.length === 0) {
                    container.html('<div style="color:#999;padding:10px;">No attachments uploaded.</div>');
                    return;
                }

                var html = '<div style="display:flex;flex-direction:column;gap:5px;">';
                attachmentFiles.forEach(function(f, idx) {
                    html += '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 12px;background:#f5f5f5;border-radius:4px;border:1px solid #ddd;">';
                    html += '<span><strong>' + f.FileName + '</strong> (' + formatFileSize(f.FileSize) + ')</span>';
                    html += '<button type="button" onclick="removeAttachment(' + idx + ')" style="color:red;background:none;border:none;cursor:pointer;">✕</button>';
                    html += '</div>';
                });
                html += '</div>';
                container.html(html);
            }

            function removeAttachment(index) {
                attachmentFiles.splice(index, 1);
                formData.Attachments = attachmentFiles;
                updateAttachmentList();
                updateTotalAttachments();
            }

            function updateTotalAttachments() {
                var inst = $("#totalAttachmentsBox").dxNumberBox('instance');
                if (inst) inst.option('value', attachmentFiles.length);
            }

            function formatFileSize(bytes) {
                if (bytes < 1024) return bytes + ' B';
                if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
                return (bytes / 1048576).toFixed(1) + ' MB';
            }

