@{
    ViewData["Title"] = "Crash records";
    bool Can(string privilege) => User.HasClaim(CrashReport.Security.Privileges.ClaimType, privilege);
    var canCreate = Can(CrashReport.Security.Privileges.Crashes.Create);
    var canQuickAdd = Can(CrashReport.Security.Privileges.Crashes.CreateSummary);
    var canEdit = Can(CrashReport.Security.Privileges.Crashes.Edit);
    var canDelete = Can(CrashReport.Security.Privileges.Crashes.Delete);
}

<style>
    .records-page { max-width:1400px; margin:0 auto; }
    .records-head { margin-bottom:1rem; }
    .records-eyebrow { color:var(--g-600); font:600 .66rem 'DM Mono',monospace; letter-spacing:1.2px; text-transform:uppercase; margin-bottom:.4rem; }
    .records-head h1 { margin:0 0 .35rem; color:#171d25; font-size:1.65rem; }
    .records-head p { margin:0; color:var(--muted); font-size:.84rem; }
    .records-actions { display:flex; gap:.5rem; align-items:center; margin-top:.85rem; }
    .records-action-note { color:#7b867e; font-size:.7rem; border-left:1px solid #dce0e5; padding-left:.7rem; margin-left:.15rem; }
    .records-actions .dx-button { border-radius:7px; height:34px; }
    .records-actions .dx-button-text { font-size:.74rem; font-weight:600; }
    .records-card { background:#fff; border:1px solid #dce0e7; border-radius:12px; overflow:hidden; box-shadow:0 7px 24px rgba(12, 18, 28, .055); }
    .records-search { display:grid; grid-template-columns:minmax(260px,1.6fr) repeat(3,minmax(145px,.65fr)) auto; gap:.65rem; padding:1rem 1.1rem; align-items:end; border-bottom:1px solid #e6e8ec; }
    .records-field label { display:block; color:#696e75; font-size:.69rem; margin-bottom:.3rem; }
    .records-advanced { display:grid; grid-template-columns:1fr 1fr auto; gap:.65rem; padding:0 1.1rem; max-height:0; opacity:0; overflow:hidden; transition:max-height .2s,opacity .2s,padding .2s; background:#fafbfc; }
    .records-advanced.open { max-height:100px; opacity:1; padding-top:.8rem; padding-bottom:.8rem; border-bottom:1px solid #e6e8ec; }
    .records-filter-btn { height:36px; padding:0 .85rem; border:1px solid var(--g-600); border-radius:6px; color:#fff; background:var(--g-600); font-size:.76rem; font-weight:600; }
    .records-filter-btn.secondary { color:#4a505a; background:#fff; border-color:#d1d6dd; }
    .records-active { display:none; gap:.4rem; flex-wrap:wrap; padding:.65rem 1.1rem; border-bottom:1px solid #e6e8ec; }
    .records-active.has-items { display:flex; }
    .filter-chip { display:inline-flex; gap:.35rem; align-items:center; padding:.27rem .55rem; border-radius:999px; color:#31415a; background:#eef1f6; border:1px solid #d0d9e6; font-size:.68rem; }
    .filter-chip button { border:0; background:transparent; color:#475a76; padding:0; line-height:1; }
    .records-table-head { display:flex; justify-content:space-between; align-items:center; gap:1rem; padding:.85rem 1.1rem; }
    .records-table-head strong { color:#282e37; font-size:.83rem; }
    .records-count { color:#747980; font:400 .69rem 'DM Mono',monospace; }
    #crashHistoryGrid .dx-datagrid { font-family:'DM Sans',sans-serif; color:#262c34; font-size:12px; }
    #crashHistoryGrid .dx-datagrid-headers { border-top:1px solid #edeff1; }
    #crashHistoryGrid .dx-header-row > td { padding-top:10px; padding-bottom:10px; background:#f7f8fa!important; color:#686d74!important; font-size:.66rem!important; }
    #crashHistoryGrid .dx-data-row > td { padding-top:11px; padding-bottom:11px; border-color:#edeff1; vertical-align:middle; }
    #crashHistoryGrid .dx-data-row:hover > td { background:#f6f8fa; }
    .record-id { color:#1d314e; font-weight:700; font-size:.76rem; }
    .record-sub { display:block; color:#8a948d; font-size:.66rem; margin-top:2px; }
    .record-place { color:#2f353d; font-weight:500; }
    .record-badge { display:inline-block; padding:.25rem .52rem; border-radius:999px; font:500 .64rem 'DM Mono',monospace; white-space:nowrap; }
    .record-badge.fatal { color:#a0352a; background:#fde9e6; }
    .record-badge.serious { color:#8a570e; background:#fff2d9; }
    .record-badge.minor { color:#253e63; background:#eef1f6; }
    .record-badge.import { color:#54616a; background:#f0f3f5; }
    .record-badge.manual { color:#253e63; background:#eef1f6; }
    .casualty-stack { display:flex; gap:.25rem; flex-wrap:wrap; }
    .record-action { border:1px solid #d5d9df; border-radius:6px; background:#fff; padding:.35rem .5rem; color:#565b62; font-size:.68rem; text-decoration:none; }
    .record-action:hover { color:#20385b; border-color:#94b5bd; }
    .record-action.danger:hover { color:#a0352a; border-color:#dca9a3; }
    @@media(max-width:980px) { .records-search { grid-template-columns:1fr 1fr; } }
    @@media(max-width:650px) { .records-actions { flex-wrap:wrap; } .records-action-note { display:none; } .records-search,.records-advanced { grid-template-columns:1fr; } .records-advanced.open { max-height:260px; } }
</style>

<div class="records-page">
    <header class="records-head">
        <div class="records-eyebrow">Crash registry</div>
        <h1>Crash records</h1>
        <p>Combined full CR1 reports, quick captures and approved imported summaries.</p>
        <div class="records-actions">
            @if (canQuickAdd) { <div id="quickAddButton"></div> }
            @if (canCreate) { <div id="fullReportButton"></div> }
            <span class="records-action-note">Choose quick capture for summary data, or full report for a complete CR1.</span>
        </div>
    </header>

    <section class="records-card">
        <div class="records-search">
            <div class="records-field"><label>Search registry</label><div id="keywordBox"></div></div>
            <div class="records-field"><label>District</label><div id="districtBox"></div></div>
            <div class="records-field"><label>Source</label><div id="sourceBox"></div></div>
            <div class="records-field"><label>Severity</label><div id="severityBox"></div></div>
            <div style="display:flex;gap:.4rem"><div id="searchButton"></div><div id="advancedButton"></div></div>
        </div>
        <div id="advancedFilters" class="records-advanced">
            <div class="records-field"><label>Date from</label><div id="dateFromBox"></div></div>
            <div class="records-field"><label>Date to</label><div id="dateToBox"></div></div>
            <div id="clearButton"></div>
        </div>
        <div id="activeFilters" class="records-active"></div>
        <div class="records-table-head"><strong>Registry results</strong><span id="resultCount" class="records-count">Loading…</span></div>
        <div id="crashHistoryGrid"></div>
    </section>
</div>

<form id="deleteForm" method="post" style="display:none">@Html.AntiForgeryToken()</form>

@section Scripts {
<script>
$(function () {
    const canEdit = @canEdit.ToString().ToLowerInvariant();
    const canDelete = @canDelete.ToString().ToLowerInvariant();
    let filters = {};


    @if (canQuickAdd)
    {
        <text>
        $('#quickAddButton').dxButton({
            text:'Quick capture', icon:'bolt', type:'normal', stylingMode:'outlined',
            onClick:() => window.location.href = '/CreateSummary/CreateSummary'
        });
        </text>
    }
    @if (canCreate)
    {
        <text>
        $('#fullReportButton').dxButton({
            text:'Create full report', icon:'plus', type:'default', stylingMode:'contained',
            onClick:() => window.location.href = '/Home/Create'
        });
        </text>
    }

    const keyword = $('#keywordBox').dxTextBox({ placeholder:'CR, CAS, AR, station, route or location', showClearButton:true, onEnterKey:applyFilters }).dxTextBox('instance');
    const district = $('#districtBox').dxSelectBox({ placeholder:'All districts', showClearButton:true, searchEnabled:true }).dxSelectBox('instance');
    const source = $('#sourceBox').dxSelectBox({ items:['Manual','Import'], placeholder:'All sources', showClearButton:true }).dxSelectBox('instance');
    const severity = $('#severityBox').dxSelectBox({ items:['Fatal','Serious','Minor'], placeholder:'All severities', showClearButton:true }).dxSelectBox('instance');
    const dateFrom = $('#dateFromBox').dxDateBox({ type:'date', displayFormat:'dd MMM yyyy', placeholder:'Start date', showClearButton:true, max:new Date() }).dxDateBox('instance');
    const dateTo = $('#dateToBox').dxDateBox({ type:'date', displayFormat:'dd MMM yyyy', placeholder:'End date', showClearButton:true, max:new Date() }).dxDateBox('instance');

    $.getJSON('/api/lookup/districts').done(data => district.option('items', data || []));
    $('#searchButton').dxButton({ text:'Search', icon:'search', type:'default', onClick:applyFilters });
    $('#advancedButton').dxButton({
        text:'More filters', icon:'filter', type:'normal', stylingMode:'outlined',
        onClick:function(e) {
            const open = $('#advancedFilters').toggleClass('open').hasClass('open');
            e.component.option('text', open ? 'Fewer filters' : 'More filters');
        }
    });
    $('#clearButton').dxButton({ text:'Clear filters', icon:'clear', type:'normal', stylingMode:'outlined', onClick:clearFilters });

    const store = new DevExpress.data.CustomStore({
        key:'RowKey',
        load:function(options) {
            const sort = options.sort && options.sort[0];
            const request = $.extend({}, filters, {
                page:Math.floor((options.skip || 0) / (options.take || 25)) + 1,
                pageSize:options.take || 25,
                sortBy:sort ? sort.selector : 'Date',
                sortDesc:sort ? !!sort.desc : true
            });
            return $.getJSON('/Crashes/Grid', request).then(result => {
                $('#resultCount').text(result.total + (result.total === 1 ? ' record' : ' records'));
                result.rows.forEach(row => row.RowKey = row.Source === 'Import' ? 'I-' + row.SummaryId : 'M-' + row.CrashId);
                return { data:result.rows, totalCount:result.total };
            }).catch(() => {
                DevExpress.ui.notify('The records could not be loaded.', 'error', 3500);
                return { data:[], totalCount:0 };
            });
        }
    });

    const grid = $('#crashHistoryGrid').dxDataGrid({
        dataSource:{ store }, remoteOperations:{ paging:true, sorting:true }, showBorders:false,
        hoverStateEnabled:true, columnAutoWidth:false, wordWrapEnabled:true,
        columns:[
            { dataField:'CrNo', caption:'CR number', minWidth:145, cellTemplate:(c,o) => c.html(`<span class="record-id">${escapeHtml(o.value || 'Not assigned')}</span><span class="record-sub">${escapeHtml(o.data.CasNo || o.data.ArNo || '')}</span>`) },
            { dataField:'Date', caption:'Date / time', width:125, dataType:'date', format:'dd MMM yyyy', cellTemplate:(c,o) => c.html(`<span>${formatDate(o.data.Date)}</span><span class="record-sub">${escapeHtml(o.data.Time || 'Time not supplied')}</span>`) },
            { dataField:'Station', caption:'Station', minWidth:135, cellTemplate:(c,o) => c.html(`<span class="record-place">${escapeHtml(o.value || 'Unknown')}</span><span class="record-sub">${escapeHtml(o.data.District || 'District unknown')}</span>`) },
            { dataField:'Location', caption:'Location', minWidth:175, cellTemplate:(c,o) => c.html(`<span class="record-place">${escapeHtml(o.data.Route || 'Route missing')}</span><span class="record-sub">${escapeHtml(o.value || 'Location not supplied')}</span>`) },
            { dataField:'CrashType', caption:'Crash type', minWidth:125 },
            { dataField:'Severity', caption:'Casualties', minWidth:180, cellTemplate:casualtyCell },
            { dataField:'Source', caption:'Source', width:92, cellTemplate:(c,o) => c.html(`<span class="record-badge ${o.value === 'Import' ? 'import' : 'manual'}">${escapeHtml(o.value)}</span>`) },
            { caption:'Actions', width:145, allowSorting:false, cellTemplate:actionCell }
        ],
        paging:{ pageSize:25 }, pager:{ visible:true, showPageSizeSelector:true, allowedPageSizes:[10,25,50,100], showInfo:true, infoText:'Page {0} of {1}' },
        sorting:{ mode:'single' }, noDataText:'No crash records match these filters.'
    }).dxDataGrid('instance');

    function casualtyCell(container, options) {
        const d = options.data, badges = [];
        if (d.Fatalities) badges.push(`<span class="record-badge fatal">${d.Fatalities} fatal</span>`);
        if (d.Serious) badges.push(`<span class="record-badge serious">${d.Serious} serious</span>`);
        if (d.Slight) badges.push(`<span class="record-badge minor">${d.Slight} slight</span>`);
        container.html(`<div class="casualty-stack">${badges.length ? badges.join('') : '<span class="record-badge minor">No injury recorded</span>'}</div>`);
    }

    function actionCell(container, options) {
        const d = options.data, imported = d.Source === 'Import', id = imported ? d.SummaryId : d.CrashId;
        if (!id) return;
        const wrap = $('<div>').css({display:'flex',gap:'5px',justifyContent:'flex-start'}).appendTo(container);
        const detailUrl = imported ? `/Crashes/EditSummary/${id}` : `/Crashes/Details/${id}`;
        $('<div>').appendTo(wrap).dxButton({
            icon:'eyeopen', hint:imported ? 'Open imported summary' : 'View crash report',
            stylingMode:'outlined', onClick:() => window.location.href = detailUrl
        });
        if (canEdit && !imported) $('<div>').appendTo(wrap).dxButton({
            icon:'edit', hint:'Edit crash report', stylingMode:'outlined',
            onClick:() => window.location.href = `/Home/Edit/${id}`
        });
        if (canDelete) $('<div>').appendTo(wrap).dxButton({
            icon:'trash', hint:'Delete record', type:'danger', stylingMode:'outlined',
            onClick:() => confirmDelete(d, imported, id)
        });
    }

    function confirmDelete(data, imported, id) {
        DevExpress.ui.dialog.confirm(`Delete <b>${escapeHtml(data.CrNo || 'this record')}</b>? This cannot be undone.`, 'Confirm deletion').then(ok => {
            if (!ok) return;
            $('#deleteForm').attr('action', imported ? `/Crashes/DeleteSummary/${id}` : `/Home/Delete/${id}`).trigger('submit');
        });
    }

    function applyFilters() {
        filters = {};
        add('Search', keyword.option('value')); add('District', district.option('value'));
        add('Source', source.option('value')); add('Severity', severity.option('value'));
        add('From', iso(dateFrom.option('value'))); add('To', iso(dateTo.option('value')));
        renderChips(); grid.pageIndex(0); grid.refresh();
    }
    function add(key,value) { if (value) filters[key] = value; }
    function clearFilters() {
        [keyword,district,source,severity,dateFrom,dateTo].forEach(widget => widget.option('value',null));
        filters = {}; renderChips(); grid.pageIndex(0); grid.refresh();
    }
    function renderChips() {
        const host = $('#activeFilters').empty();
        Object.entries(filters).forEach(([key,value]) => $('<span>').addClass('filter-chip').html(`${key}: <strong>${escapeHtml(value)}</strong>`).append($('<button type="button">').text('×').on('click', () => { delete filters[key]; renderChips(); grid.refresh(); })).appendTo(host));
        host.toggleClass('has-items', Object.keys(filters).length > 0);
    }
    function iso(value) { if (!value) return null; const d = new Date(value); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }
    function formatDate(value) { if (!value) return 'Date missing'; return new Date(value + 'T00:00:00').toLocaleDateString('en-ZA',{day:'2-digit',month:'short',year:'numeric'}); }
    function escapeHtml(value) { return $('<div>').text(value == null ? '' : String(value)).html(); }
});
</script>
}
