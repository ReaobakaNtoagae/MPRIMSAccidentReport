@{
    ViewData["Title"] = "Crash Reports";
}

<style>
     #crashHistoryGrid .dx-datagrid {
        font-size: 12px;
    }

    #crashHistoryGrid .dx-datagrid-headers {
        font-size: 12px;
        font-weight: 600;
    }

   
    #crashHistoryGrid .dx-row > td {
        padding-top: 6px;
        padding-bottom: 6px;
    }

    .toolbar-panel {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #c8e6c9;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        padding: 14px 20px;
        margin-bottom: 16px;
        display: flex;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: wrap;
    }

    .toolbar-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 160px;
    }

        .toolbar-field label {
            font-size: .7rem;
            color: #666;
        }

    .filter-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #e8f5e9;
        border: 1px solid #a5d6a7;
        border-radius: 20px;
        padding: 3px 10px;
        font-size: .75rem;
        color: #1b5e20;
        font-weight: 600;
    }

        .filter-badge .remove {
            cursor: pointer;
            color: #2e7d32;
            font-weight: 700;
            font-size: .8rem;
        }

    .active-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 10px;
        width: 100%;
    }

    .result-count {
        font-size: .8rem;
        color: #555;
        font-weight: 500;


    .dx-datagrid-filter-row .dx-editor-cell {
        background: #fafcf8;
    }
</style>


<div class="toolbar-panel">
    <div class="toolbar-field" style="min-width:220px;">
        <label>Keyword search</label>
        <div id="keywordBox"></div>
    </div>
    <div class="toolbar-field">
        <label>Date from</label>
        <div id="dateFromBox"></div>
    </div>
    <div class="toolbar-field">
        <label>Date to</label>
        <div id="dateToBox"></div>
    </div>
    <div class="toolbar-field">
        <label>Severity</label>
        <div id="severityBox"></div>
    </div>
    <div id="btnSearch" style="min-width:110px;"></div>
    <div id="btnClear" style="min-width:90px;"></div>
    <div class="active-filters" id="activeBadges"></div>
</div>


<div style="background:#fff;border-radius:10px;border:1px solid #c8e6c9;
    box-shadow:0 2px 8px rgba(0,0,0,.06);overflow:hidden;">
    <div style="display:flex;align-items:center;justify-content:space-between;
        padding:14px 20px;border-bottom:2px solid #e8f5e9;">
        <div style="font-size:.78rem;text-transform:uppercase;letter-spacing:.7px;
            color:#2e7d32;font-weight:700;">
            Crash reports
            <span style="font-size:.68rem;text-transform:none;letter-spacing:0;color:#9ca3af;font-weight:400;">
                &nbsp;&middot; includes manually captured and imported records &middot; filter by District/Station/Route/Type/Source in the column headers below
            </span>
        </div>
        <div style="display:flex;align-items:center;gap:12px;">
            <span class="result-count" id="resultCount"></span>
            <div id="btnQuickAdd"></div>
            <div id="btnNewReport"></div>
        </div>
    </div>
    <div id="crashHistoryGrid"></div>
</div>

<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        $(function () {

            var districts = [];
            $.getJSON("/api/lookup/districts").done(function (data) {
                districts = data || [];
                gridInst.columnOption("District", "lookup", { dataSource: districts });
            });

            
            var keywordInst = $("#keywordBox").dxTextBox({
                placeholder: "CR number, route, or location",
                showClearButton: true,
                onEnterKey: function () { runSearch(); }
            }).dxTextBox("instance");

            var dateFromInst = $("#dateFromBox").dxDateBox({
                type: "date", displayFormat: "dd/MM/yyyy", pickerType: "calendar",
                placeholder: "From date", showClearButton: true, max: new Date()
            }).dxDateBox("instance");

            var dateToInst = $("#dateToBox").dxDateBox({
                type: "date", displayFormat: "dd/MM/yyyy", pickerType: "calendar",
                placeholder: "To date", showClearButton: true, max: new Date()
            }).dxDateBox("instance");

            var severityInst = $("#severityBox").dxSelectBox({
                dataSource: ["Minor", "Serious", "Fatal"],
                placeholder: "Any severity", showClearButton: true,
                onValueChanged: function () { runSearch(); }
            }).dxSelectBox("instance");

            $("#btnSearch").dxButton({
                text: "Search", type: "default", icon: "find", onClick: runSearch
            });
            $("#btnClear").dxButton({
                text: "Clear", type: "normal", icon: "clear", stylingMode: "outlined",
                onClick: clearAll
            });
            $("#btnQuickAdd").dxButton({
                text: "Quick add", type: "normal", icon: "bolt",
                onClick: function () { window.location.href = "/CreateSummary/CreateSummary"; }
            });
            $("#btnNewReport").dxButton({
                text: "New CR1 report", type: "default", icon: "plus",
                onClick: function () { window.location.href = "/Home/Create"; }
            });

           
            var currentSearchParams = {};

            var crashStore = new DevExpress.data.CustomStore({
                key: "RowKey",
                load: function (loadOptions) {
                    var page = Math.floor((loadOptions.skip || 0) / (loadOptions.take || 25)) + 1;
                    var params = $.extend({
                        page: page,
                        pageSize: loadOptions.take || 25,
                        sortBy: (loadOptions.sort && loadOptions.sort[0]) ? loadOptions.sort[0].selector : "Date",
                        sortDesc: (loadOptions.sort && loadOptions.sort[0]) ? !!loadOptions.sort[0].desc : true
                    }, currentSearchParams);

                    return $.getJSON("/Crashes/Grid", params).then(function (result) {
                        $("#resultCount").text(result.total > 0 ? result.total + " results" : "");
                        var rows = result.rows.map(function (r) {
                            r.RowKey = r.Source === "Import" ? "I-" + r.SummaryId : "M-" + r.CrashId;
                            return r;
                        });
                        return { data: rows, totalCount: result.total };
                    }).catch(function () {
                        DevExpress.ui.notify("Search failed. Please try again.", "error", 3000);
                        return { data: [], totalCount: 0 };
                    });
                }
            });

            // Column -> query-param name, for the ones now filtered via the
            // column header row instead of the top toolbar.
            var columnParamMap = {
                District: "district",
                Station: "sapsStation",
                Route: "route",
                CrashType: "crashType",
                Source: "source"
            };

            // Prevents DevExtreme from also trying to apply its own
            // (client-side, page-only) filter on top of what the server
            // already filtered — the column "consumes" its filterValue via
            // our own handling instead.
            function neutralizeFilterExpression() { return null; }

            var gridInst = $("#crashHistoryGrid").dxDataGrid({
                dataSource: { store: crashStore },
                remoteOperations: { paging: true, sorting: true },
                filterRow: { visible: true, applyFilter: "auto" },
                columns: [
                    { dataField: "CrNo",     caption: "CR No.",   width: 120, allowFiltering: false },
                    {
                        dataField: "Date",   caption: "Date",
                        dataType: "date",    format: "dd MMM yyyy", width: 130,
                        allowFiltering: false // date range stays in the top bar (two values, not one)
                    },
                    {
                        dataField: "District", caption: "District", width: 140,
                        calculateFilterExpression: neutralizeFilterExpression,
                        lookup: { dataSource: [] } // populated once /api/lookup/districts resolves
                    },
                    {
                        dataField: "Station",  caption: "Station",  width: 130,
                        calculateFilterExpression: neutralizeFilterExpression
                    },
                    {
                        dataField: "Route",    caption: "Route",    width: 90,
                        calculateFilterExpression: neutralizeFilterExpression
                    },
                    {
                        dataField: "CrashType", caption: "Crash type", width: 130,
                        calculateFilterExpression: neutralizeFilterExpression
                    },
                    { dataField: "VehicleCount", caption: "Vehicles", width: 80, alignment: "center", allowFiltering: false },
                    {
                        caption: "Injuries", width: 200, alignment: "center",
                        allowSorting: false, allowFiltering: false,
                        cellTemplate: function (container, options) {
                            var parts = [];
                            if (options.data.Fatalities > 0)
                                parts.push('<span style="background:#b71c1c;color:#fff;' +
                                    'border-radius:10px;padding:1px 9px;font-size:.72rem;' +
                                    'font-weight:700;margin-right:3px">' +
                                    options.data.Fatalities + ' fatal</span>');
                            if (options.data.Serious > 0)
                                parts.push('<span style="background:#e65100;color:#fff;' +
                                    'border-radius:10px;padding:1px 9px;font-size:.72rem;' +
                                    'margin-right:3px">' +
                                    options.data.Serious + ' serious</span>');
                            container.html(parts.length ? parts.join("") :
                                '<span style="color:#bbb;font-size:.75rem">—</span>');
                        }
                    },
                    {
                        dataField: "Source", caption: "Source", width: 90, alignment: "center",
                        calculateFilterExpression: neutralizeFilterExpression,
                        lookup: { dataSource: ["Manual", "Import"] },
                        cellTemplate: function (container, options) {
                            var isImport = options.value === "Import";
                            container.html(
                                '<span style="font-size:.68rem;padding:2px 8px;border-radius:6px;' +
                                (isImport
                                    ? 'background:#f5f5f5;color:#9e9e9e;'
                                    : 'background:#e8f5e9;color:#2e7d32;') +
                                '">' + options.value + '</span>'
                            );
                        }
                    },
                    {
                        caption: "Actions", width: 145, alignment: "center",
                        allowSorting: false, allowFiltering: false,
                        cellTemplate: function (container, options) {
                            var data = options.data;
                            var isImport = data.Source === "Import";
                            var id = isImport ? data.SummaryId : data.CrashId;
                            var crNo = data.CrNo || ("#" + (id || ""));

                            if (!id) {
                                container.html('<span style="color:#bbb;font-size:.75rem">—</span>');
                                return;
                            }

                            var editUrl   = isImport ? "/Crashes/EditSummary/" + id   : "/Home/Edit/" + id;
                            var deleteUrl = isImport ? "/Crashes/DeleteSummary/" + id : "/Home/Delete/" + id;

                            $("<div>").css({ display:"flex", gap:"5px", justifyContent:"center" })
                                .appendTo(container)
                                .append(
                                    $("<div>").dxButton({
                                        icon:"edit", hint: isImport ? "Edit imported record" : "Edit",
                                        type:"normal", stylingMode:"outlined",
                                        onClick: function() { window.location.href = editUrl; }
                                    }),
                                    $("<div>").dxButton({
                                        icon:"trash", hint: isImport ? "Delete imported record" : "Delete",
                                        type:"danger", stylingMode:"outlined",
                                        onClick: function() {
                                            var warning = isImport
                                                ? "Permanently delete imported record <b>" + crNo + "</b>?"
                                                : "Permanently delete crash report <b>" + crNo + "</b>?<br/>" +
                                                  "<small style='color:#888'>All linked records will also be removed.</small>";
                                            DevExpress.ui.dialog.confirm(warning, "Confirm Delete").then(function(confirmed) {
                                                if (!confirmed) return;
                                                $("#deleteForm").attr("action", deleteUrl);
                                                $("#deleteForm").submit();
                                            });
                                        }
                                    })
                                );
                        }
                    }
                ],
                paging:  { pageSize: 25 },
                pager:   { showPageSizeSelector: true, allowedPageSizes: [10,25,50,100],
                           showInfo: true, infoText: "{0}–{1} of {2} crashes" },
                sorting: { mode: "single" },
                showBorders:           false,
                rowAlternationEnabled: true,
                hoverStateEnabled:     true,
                noDataText:            "No crashes match the current filters.",
                onRowPrepared: function (e) {
                    if (e.rowType === "data" && e.data.Fatalities > 0)
                        e.rowElement.css("border-left", "3px solid #b71c1c");
                },
                // Reads whichever column's filterValue just changed and
                // merges it into the same server-side param the old
                // sidebar used to send — this is what makes the filter
                // row actually talk to /Crashes/Grid correctly.
                onOptionChanged: function (e) {
                    if (e.fullName && /^columns\[\d+\]\.filterValue$/.test(e.fullName)) {
                        var colIndex = parseInt(e.fullName.match(/\d+/)[0], 10);
                        var col = gridInst.columnOption(colIndex);
                        var paramName = columnParamMap[col.dataField];
                        if (!paramName) return;

                        if (e.value) currentSearchParams[paramName] = e.value;
                        else delete currentSearchParams[paramName];

                        updateBadges(currentSearchParams);
                        gridInst.refresh();
                    }
                }
            }).dxDataGrid("instance");

            function runSearch() {
                // Top-bar fields merge in on top of whatever the column
                // filter row currently has set, rather than replacing it.
                if (keywordInst.option("value")) currentSearchParams.keyword = keywordInst.option("value");
                else delete currentSearchParams.keyword;

                if (dateFromInst.option("value")) currentSearchParams.dateFrom = formatDate(dateFromInst.option("value"));
                else delete currentSearchParams.dateFrom;

                if (dateToInst.option("value")) currentSearchParams.dateTo = formatDate(dateToInst.option("value"));
                else delete currentSearchParams.dateTo;

                if (severityInst.option("value")) currentSearchParams.severity = severityInst.option("value");
                else delete currentSearchParams.severity;

                updateBadges(currentSearchParams);
                gridInst.refresh();
            }

            function formatDate(d) {
                var dt = new Date(d);
                return dt.getFullYear() + "-" +
                       String(dt.getMonth() + 1).padStart(2,"0") + "-" +
                       String(dt.getDate()).padStart(2,"0");
            }

            var badgeLabels = {
                keyword:"Keyword", district:"District", sapsStation:"Station",
                route:"Route", crashType:"Type", severity:"Severity",
                source:"Source", dateFrom:"From", dateTo:"To"
            };

            function updateBadges(params) {
                var container = $("#activeBadges").empty();
                Object.keys(params).forEach(function (key) {
                    var val = params[key];
                    if (!val) return;
                    var badge = $('<span class="filter-badge">' +
                        badgeLabels[key] + ': <strong>' + val + '</strong>' +
                        ' <span class="remove" data-key="' + key + '">✕</span></span>');
                    container.append(badge);
                });
                container.find(".remove").on("click", function () {
                    clearOneFilter($(this).data("key"));
                });
            }

            function clearOneFilter(key) {
                delete currentSearchParams[key];

                
                if (key === "keyword") keywordInst.option("value", null);
                else if (key === "dateFrom") dateFromInst.option("value", null);
                else if (key === "dateTo") dateToInst.option("value", null);
                else if (key === "severity") severityInst.option("value", null);
                else {
                    
                    var entry = Object.entries(columnParamMap).find(function (e) { return e[1] === key; });
                    if (entry) {
                        gridInst.columnOption(entry[0], "filterValue", null);
                        return; 
                    }
                }

                updateBadges(currentSearchParams);
                gridInst.refresh();
            }

            function clearAll() {
                keywordInst.option("value", null);
                dateFromInst.option("value", null);
                dateToInst.option("value", null);
                severityInst.option("value", null);
                gridInst.clearFilter("row");
                currentSearchParams = {};
                updateBadges(currentSearchParams);
                gridInst.refresh();
            }

            runSearch();
        });
    </script>
}
