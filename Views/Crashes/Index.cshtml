@{
    ViewData["Title"] = "Crash Reports";
}

<style>
    .search-panel {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #c8e6c9;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        padding: 20px 24px;
        margin-bottom: 16px;
    }

    .search-panel-title {
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .7px;
        color: #2e7d32;
        font-weight: 700;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        user-select: none;
    }

        .search-panel-title .toggle-icon {
            font-size: .85rem;
            transition: transform .2s;
        }

            .search-panel-title .toggle-icon.collapsed {
                transform: rotate(-90deg);
            }

    .search-row {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 12px;
        margin-bottom: 12px;
    }

        .search-row.two-col {
            grid-template-columns: 1fr 1fr auto auto;
            align-items: end;
        }

    .filter-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #e8f5e9;
        border: 1px solid #a5d6a7;
        border-radius: 20px;
        padding: 3px 10px;
        font-size: .75rem;
        color: #1b5e20;
        font-weight: 600;
    }

        .filter-badge .remove {
            cursor: pointer;
            color: #2e7d32;
            font-weight: 700;
            font-size: .8rem;
        }

    .active-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 10px;
    }

    .result-count {
        font-size: .8rem;
        color: #555;
        font-weight: 500;
    }
</style>

<!-- Search & Filter Panel -->
<div class="search-panel">
    <div class="search-panel-title" id="toggleFilters">
        <span>🔍 Search &amp; Filter</span>
        <span class="toggle-icon" id="toggleIcon">▼</span>
    </div>
    <div id="filterBody">
        <div class="search-row">
            <div>
                <div style="font-size:.72rem;color:#666;margin-bottom:4px;">Keyword search</div>
                <div id="keywordBox"></div>
            </div>
            <div>
                <div style="font-size:.72rem;color:#666;margin-bottom:4px;">District</div>
                <div id="districtBox"></div>
            </div>
            <div>
                <div style="font-size:.72rem;color:#666;margin-bottom:4px;">SAPS station</div>
                <div id="sapsBox"></div>
            </div>
            <div>
                <div style="font-size:.72rem;color:#666;margin-bottom:4px;">Route</div>
                <div id="routeBox"></div>
            </div>
        </div>
        <div class="search-row">
            <div>
                <div style="font-size:.72rem;color:#666;margin-bottom:4px;">Date from</div>
                <div id="dateFromBox"></div>
            </div>
            <div>
                <div style="font-size:.72rem;color:#666;margin-bottom:4px;">Date to</div>
                <div id="dateToBox"></div>
            </div>
            <div>
                <div style="font-size:.72rem;color:#666;margin-bottom:4px;">Crash type</div>
                <div id="crashTypeBox"></div>
            </div>
            <div>
                <div style="font-size:.72rem;color:#666;margin-bottom:4px;">Severity</div>
                <div id="severityBox"></div>
            </div>
        </div>
        <div class="search-row two-col">
            <div>
                <div style="font-size:.72rem;color:#666;margin-bottom:4px;">Source</div>
                <div id="sourceBox"></div>
            </div>
            <div></div>
            <div id="btnSearch" style="min-width:120px;"></div>
            <div id="btnClear" style="min-width:100px;"></div>
        </div>
        <div class="active-filters" id="activeBadges"></div>
    </div>
</div>

<!-- Results -->
<div style="background:#fff;border-radius:10px;border:1px solid #c8e6c9;
    box-shadow:0 2px 8px rgba(0,0,0,.06);overflow:hidden;">
    <div style="display:flex;align-items:center;justify-content:space-between;
        padding:14px 20px;border-bottom:2px solid #e8f5e9;">
        <div style="font-size:.78rem;text-transform:uppercase;letter-spacing:.7px;
            color:#2e7d32;font-weight:700;">
            Crash reports
            <span style="font-size:.68rem;text-transform:none;letter-spacing:0;color:#9ca3af;font-weight:400;">
                &nbsp;&middot; includes manually captured and imported records
            </span>
        </div>
        <div style="display:flex;align-items:center;gap:12px;">
            <span class="result-count" id="resultCount"></span>
            <div id="btnQuickAdd"></div>
            <div id="btnNewReport"></div>
        </div>
    </div>
    <div id="crashHistoryGrid"></div>
</div>

<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        $(function () {

            var districts = [];
            $.getJSON("/api/lookup/districts").done(function (data) {
                districts = data || [];
                districtInst.option("dataSource", districts);
            });

            var keywordInst = $("#keywordBox").dxTextBox({
                placeholder: "CR number, route, or location",
                showClearButton: true,
                onEnterKey: function () { runSearch(); }
            }).dxTextBox("instance");

            var districtInst = $("#districtBox").dxSelectBox({
                dataSource: districts,
                placeholder: "Any district",
                showClearButton: true,
                searchEnabled: true
            }).dxSelectBox("instance");

            var sapsInst = $("#sapsBox").dxSelectBox({
                dataSource: {
                    load: function (loadOptions) { return $.getJSON("/api/lookup/stations", { q: loadOptions.searchValue }); }
                },
                displayExpr: "text",
                valueExpr: "text",
                placeholder: "Any station",
                showClearButton: true,
                searchEnabled: true,
                acceptCustomValue: true
            }).dxSelectBox("instance");

            var routeInst = $("#routeBox").dxSelectBox({
                dataSource: {
                    load: function (loadOptions) { return $.getJSON("/api/lookup/routes", { q: loadOptions.searchValue }); }
                },
                displayExpr: "text",
                valueExpr: "text",
                placeholder: "Any route",
                showClearButton: true,
                searchEnabled: true,
                acceptCustomValue: true
            }).dxSelectBox("instance");

            var dateFromInst = $("#dateFromBox").dxDateBox({
                type: "date", displayFormat: "dd/MM/yyyy", pickerType: "calendar",
                placeholder: "From date", showClearButton: true, max: new Date()
            }).dxDateBox("instance");

            var dateToInst = $("#dateToBox").dxDateBox({
                type: "date", displayFormat: "dd/MM/yyyy", pickerType: "calendar",
                placeholder: "To date", showClearButton: true, max: new Date()
            }).dxDateBox("instance");

            var crashTypeInst = $("#crashTypeBox").dxSelectBox({
                dataSource: {
                    load: function (loadOptions) { return $.getJSON("/api/lookup/crashtypes", { q: loadOptions.searchValue }); }
                },
                displayExpr: "text",
                valueExpr: "text",
                placeholder: "Any crash type",
                showClearButton: true,
                searchEnabled: true,
                acceptCustomValue: true
            }).dxSelectBox("instance");

            var severityInst = $("#severityBox").dxSelectBox({
                dataSource: ["Minor", "Serious", "Fatal"],
                placeholder: "Any severity", showClearButton: true
            }).dxSelectBox("instance");

            var sourceInst = $("#sourceBox").dxSelectBox({
                dataSource: ["Manual", "Import"],
                placeholder: "Any source", showClearButton: true
            }).dxSelectBox("instance");

            $("#btnSearch").dxButton({
                text: "Search", type: "default", icon: "find", onClick: runSearch
            });
            $("#btnClear").dxButton({
                text: "Clear", type: "normal", icon: "clear", stylingMode: "outlined",
                onClick: clearAll
            });
            $("#btnQuickAdd").dxButton({
                text: "Quick add", type: "normal", icon: "bolt",
                onClick: function () { window.location.href = "/CreateSummary/CreateSummary"; }
            });
            $("#btnNewReport").dxButton({
                text: "New CR1 report", type: "default", icon: "plus",
                onClick: function () { window.location.href = "/Home/Create"; }
            });

            var filterOpen = true;
            $("#toggleFilters").on("click", function () {
                filterOpen = !filterOpen;
                $("#filterBody").slideToggle(200);
                $("#toggleIcon").toggleClass("collapsed", !filterOpen);
            });

            // ── Same grid as the dashboard's crashHistoryGrid — same columns,
            // same CustomStore against /Crashes/Grid, same RowKey trick. Kept
            // identical deliberately so the two pages can't drift apart into
            // two different ideas of what a "crash row" looks like.
            var currentSearchParams = {};

            var crashStore = new DevExpress.data.CustomStore({
                key: "RowKey",
                load: function (loadOptions) {
                    var page = Math.floor((loadOptions.skip || 0) / (loadOptions.take || 25)) + 1;
                    var params = $.extend({
                        page: page,
                        pageSize: loadOptions.take || 25,
                        sortBy: (loadOptions.sort && loadOptions.sort[0]) ? loadOptions.sort[0].selector : "Date",
                        sortDesc: (loadOptions.sort && loadOptions.sort[0]) ? !!loadOptions.sort[0].desc : true
                    }, currentSearchParams);

                    return $.getJSON("/Crashes/Grid", params).then(function (result) {
                        $("#resultCount").text(result.total > 0 ? result.total + " results" : "");
                        var rows = result.rows.map(function (r) {
                            r.RowKey = r.Source === "Import" ? "I-" + r.SummaryId : "M-" + r.CrashId;
                            return r;
                        });
                        return { data: rows, totalCount: result.total };
                    }).catch(function () {
                        DevExpress.ui.notify("Search failed. Please try again.", "error", 3000);
                        return { data: [], totalCount: 0 };
                    });
                }
            });

            var gridInst = $("#crashHistoryGrid").dxDataGrid({
                dataSource: { store: crashStore },
                remoteOperations: { paging: true, sorting: true },
                columns: [
                    { dataField: "CrNo",     caption: "CR No.",   width: 120 },
                    {
                        dataField: "Date",   caption: "Date",
                        dataType: "date",    format: "dd MMM yyyy", width: 130
                    },
                    { dataField: "District", caption: "District", width: 140 },
                    { dataField: "Station",  caption: "Station",  width: 130 },
                    { dataField: "Route",    caption: "Route",    width: 90  },
                    { dataField: "CrashType", caption: "Crash type", width: 130 },
                    { dataField: "VehicleCount", caption: "Vehicles", width: 80, alignment: "center" },
                    {
                        caption: "Injuries", width: 200, alignment: "center",
                        allowSorting: false,
                        cellTemplate: function (container, options) {
                            var parts = [];
                            if (options.data.Fatalities > 0)
                                parts.push('<span style="background:#b71c1c;color:#fff;' +
                                    'border-radius:10px;padding:1px 9px;font-size:.72rem;' +
                                    'font-weight:700;margin-right:3px">' +
                                    options.data.Fatalities + ' fatal</span>');
                            if (options.data.Serious > 0)
                                parts.push('<span style="background:#e65100;color:#fff;' +
                                    'border-radius:10px;padding:1px 9px;font-size:.72rem;' +
                                    'margin-right:3px">' +
                                    options.data.Serious + ' serious</span>');
                            container.html(parts.length ? parts.join("") :
                                '<span style="color:#bbb;font-size:.75rem">—</span>');
                        }
                    },
                    {
                        dataField: "Source", caption: "Source", width: 90, alignment: "center",
                        cellTemplate: function (container, options) {
                            var isImport = options.value === "Import";
                            container.html(
                                '<span style="font-size:.68rem;padding:2px 8px;border-radius:6px;' +
                                (isImport
                                    ? 'background:#f5f5f5;color:#9e9e9e;'
                                    : 'background:#e8f5e9;color:#2e7d32;') +
                                '">' + options.value + '</span>'
                            );
                        }
                    },
                    {
                        caption: "Actions", width: 145, alignment: "center",
                        allowSorting: false, allowFiltering: false,
                        cellTemplate: function (container, options) {
                            var data = options.data;
                            var isImport = data.Source === "Import";
                            var id = isImport ? data.SummaryId : data.CrashId;
                            var crNo = data.CrNo || ("#" + (id || ""));

                            if (!id) {
                                container.html('<span style="color:#bbb;font-size:.75rem">—</span>');
                                return;
                            }

                            var editUrl   = isImport ? "/Crashes/EditSummary/" + id   : "/Home/Edit/" + id;
                            var deleteUrl = isImport ? "/Crashes/DeleteSummary/" + id : "/Home/Delete/" + id;

                            $("<div>").css({ display:"flex", gap:"5px", justifyContent:"center" })
                                .appendTo(container)
                                .append(
                                    $("<div>").dxButton({
                                        icon:"edit", hint: isImport ? "Edit imported record" : "Edit",
                                        type:"normal", stylingMode:"outlined",
                                        onClick: function() { window.location.href = editUrl; }
                                    }),
                                    $("<div>").dxButton({
                                        icon:"trash", hint: isImport ? "Delete imported record" : "Delete",
                                        type:"danger", stylingMode:"outlined",
                                        onClick: function() {
                                            var warning = isImport
                                                ? "Permanently delete imported record <b>" + crNo + "</b>?"
                                                : "Permanently delete crash report <b>" + crNo + "</b>?<br/>" +
                                                  "<small style='color:#888'>All linked records will also be removed.</small>";
                                            DevExpress.ui.dialog.confirm(warning, "Confirm Delete").then(function(confirmed) {
                                                if (!confirmed) return;
                                                $("#deleteForm").attr("action", deleteUrl);
                                                $("#deleteForm").submit();
                                            });
                                        }
                                    })
                                );
                        }
                    }
                ],
                paging:  { pageSize: 25 },
                pager:   { showPageSizeSelector: true, allowedPageSizes: [10,25,50,100],
                           showInfo: true, infoText: "{0}–{1} of {2} crashes" },
                sorting: { mode: "single" },
                showBorders:           false,
                rowAlternationEnabled: true,
                hoverStateEnabled:     true,
                noDataText:            "No crashes match the current filters.",
                onRowPrepared: function (e) {
                    if (e.rowType === "data" && e.data.Fatalities > 0)
                        e.rowElement.css("border-left", "3px solid #b71c1c");
                }
            }).dxDataGrid("instance");

            function runSearch() {
                currentSearchParams = buildParams();
                updateBadges(currentSearchParams);
                gridInst.refresh();
            }

            function buildParams() {
                var p = {};
                if (keywordInst.option("value"))   p.keyword    = keywordInst.option("value");
                if (districtInst.option("value"))  p.district   = districtInst.option("value");
                if (sapsInst.option("value"))       p.sapsStation = sapsInst.option("value");
                if (routeInst.option("value"))      p.route      = routeInst.option("value");
                if (crashTypeInst.option("value"))  p.crashType  = crashTypeInst.option("value");
                if (severityInst.option("value"))   p.severity   = severityInst.option("value");
                if (sourceInst.option("value"))      p.source     = sourceInst.option("value");
                if (dateFromInst.option("value"))   p.dateFrom   = formatDate(dateFromInst.option("value"));
                if (dateToInst.option("value"))     p.dateTo     = formatDate(dateToInst.option("value"));
                return p;
            }

            function formatDate(d) {
                var dt = new Date(d);
                return dt.getFullYear() + "-" +
                       String(dt.getMonth() + 1).padStart(2,"0") + "-" +
                       String(dt.getDate()).padStart(2,"0");
            }

            var badgeLabels = {
                keyword:"Keyword", district:"District", sapsStation:"Station",
                route:"Route", crashType:"Type", severity:"Severity",
                source:"Source", dateFrom:"From", dateTo:"To"
            };

            function updateBadges(params) {
                var container = $("#activeBadges").empty();
                Object.keys(params).forEach(function (key) {
                    var val = params[key];
                    if (!val) return;
                    var badge = $('<span class="filter-badge">' +
                        badgeLabels[key] + ': <strong>' + val + '</strong>' +
                        ' <span class="remove" data-key="' + key + '">✕</span></span>');
                    container.append(badge);
                });
                container.find(".remove").on("click", function () {
                    clearFilter($(this).data("key"));
                    runSearch();
                });
            }

            function clearFilter(key) {
                var map = {
                    keyword:     function () { keywordInst.option("value", null); },
                    district:    function () { districtInst.option("value", null); },
                    sapsStation: function () { sapsInst.option("value", null); },
                    route:       function () { routeInst.option("value", null); },
                    crashType:   function () { crashTypeInst.option("value", null); },
                    severity:    function () { severityInst.option("value", null); },
                    source:      function () { sourceInst.option("value", null); },
                    dateFrom:    function () { dateFromInst.option("value", null); },
                    dateTo:      function () { dateToInst.option("value", null); }
                };
                if (map[key]) map[key]();
            }

            function clearAll() {
                Object.keys(badgeLabels).forEach(clearFilter);
                $("#activeBadges").empty();
                runSearch();
            }

            runSearch();
        });
    </script>
}

