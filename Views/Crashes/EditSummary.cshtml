@model CrashReport.ViewModels.EditSummaryViewModel
@{
    ViewData["Title"] = "Edit crash record";
}

<style>
    .qa-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #c8e6c9;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        padding: 24px;
        max-width: 820px;
    }

    .qa-note {
        background: #e6f1fb;
        border: 1px solid #b5d4f4;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: .8rem;
        color: #0c447c;
        margin-bottom: 20px;
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .qa-section-title {
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .7px;
        color: #2e7d32;
        font-weight: 700;
        margin: 20px 0 10px;
    }

    .qa-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 12px;
    }

    .qa-field label {
        font-size: .72rem;
        color: #666;
        display: block;
        margin-bottom: 4px;
    }

    .qa-vehicle-card {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #c8e6c9;
        border-radius: 8px;
        padding: 8px 12px;
        margin-bottom: 8px;
        background: #f8fdf8;
    }

    .qa-vehicle-badge {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #2e7d32;
        color: #fff;
        font-size: .72rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .qa-casualty-grid {
        display: grid;
        grid-template-columns: 90px repeat(4, 1fr);
        gap: 6px;
        margin-bottom: 16px;
    }

        .qa-casualty-grid .qa-col-header {
            text-align: center;
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .4px;
            color: #888;
            font-weight: 700;
        }

        .qa-casualty-grid .qa-row-header {
            font-size: .78rem;
            font-weight: 700;
            display: flex;
            align-items: center;
        }

    .qa-row-header.fatal {
        color: #b71c1c;
    }

    .qa-row-header.serious {
        color: #a15c00;
    }

    .qa-row-header.slight {
        color: #555;
    }

    .qa-stepper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        border-radius: 6px;
        padding: 4px;
    }

        .qa-stepper.fatal {
            background: #ffebee;
        }

        .qa-stepper.serious {
            background: #fff3e0;
        }

        .qa-stepper.slight {
            background: #f5f5f5;
        }

    .qa-stepper-count {
        width: 22px;
        text-align: center;
        font-size: .85rem;
        font-weight: 700;
    }

    .qa-stepper.fatal .qa-stepper-count {
        color: #b71c1c;
    }

    .qa-stepper.serious .qa-stepper-count {
        color: #a15c00;
    }

    .qa-stepper-btn {
        width: 24px;
        height: 24px;
        border: 1px solid #ccc;
        background: #fff;
        border-radius: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: .8rem;
        line-height: 1;
        padding: 0;
    }

        .qa-stepper-btn:hover {
            background: #f0f0f0;
        }

    .qa-person-row {
        display: grid;
        grid-template-columns: 130px 1.3fr 1fr 70px 1fr 32px;
        gap: 8px;
        align-items: center;
        margin-bottom: 6px;
        padding: 6px 10px;
        border-radius: 6px;
        border-left: 3px solid transparent;
    }

        .qa-person-row.fatal {
            background: #ffebee;
            border-left-color: #b71c1c;
        }

        .qa-person-row.serious {
            background: #fff3e0;
            border-left-color: #e65100;
        }

        .qa-person-row.slight {
            background: #f5f5f5;
            border-left-color: #999;
        }

    .qa-person-label {
        font-size: .74rem;
        font-weight: 700;
    }

    .qa-person-row.fatal .qa-person-label {
        color: #b71c1c;
    }

    .qa-person-row.serious .qa-person-label {
        color: #a15c00;
    }

    .qa-person-row.slight .qa-person-label {
        color: #555;
    }

    .qa-person-remove {
        width: 28px;
        height: 28px;
        border: none;
        background: transparent;
        color: #b71c1c;
        cursor: pointer;
        font-size: .95rem;
    }
</style>

<div class="qa-card">
    <div class="qa-note">
        <i class="ti ti-edit" style="font-size:16px;" aria-hidden="true"></i>
        <span>Editing a crash record. CR number, station, and details can all be updated below.</span>
    </div>

    <div class="qa-section-title">Identification</div>
    <div class="qa-row">
        <div class="qa-field"><label>CR number</label><div id="crNoBox"></div></div>
        <div class="qa-field"><label>CAS number</label><div id="casNoBox"></div></div>
        <div class="qa-field"><label>Station</label><div id="stationBox"></div></div>
    </div>

    <div class="qa-section-title">Crash details</div>
    <div class="qa-row">
        <div class="qa-field"><label>Date</label><div id="crashDateBox"></div></div>
        <div class="qa-field"><label>Time</label><div id="crashTimeBox"></div></div>
        <div class="qa-field"><label>Crash type</label><div id="crashTypeBox"></div></div>
    </div>
    <div class="qa-row">
        <div class="qa-field"><label>Route</label><div id="routeBox"></div></div>
        <div class="qa-field" style="grid-column: span 2;"><label>Location</label><div id="locationBox"></div></div>
    </div>

    <div class="qa-section-title">Vehicles</div>
    <div id="vehicleCards"></div>
    <div id="btnAddVehicle" style="margin-bottom: 20px;"></div>

    <div class="qa-section-title">Casualties</div>
    <div class="qa-casualty-grid" id="casualtyGrid">
        <div></div>
        <div class="qa-col-header">Driver</div>
        <div class="qa-col-header">Passenger</div>
        <div class="qa-col-header">Pedestrian</div>
        <div class="qa-col-header">Cyclist</div>
    </div>

    <div style="font-size:.75rem;color:#9ca3af;margin:0 0 12px;">
        Tap + for each casualty by severity and role. Remove an entry directly with the × and the
        count above updates to match. Age, gender, race, and vehicle are all optional.
    </div>
    <div id="personRows"></div>

    <div class="qa-section-title" style="margin-top: 28px;">Save</div>
    <div style="display:flex; gap:10px;">
        <div id="btnSave" style="min-width:140px;"></div>
        <div id="btnCancel" style="min-width:100px;"></div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {

            var summaryId = @Model.Summary.SummaryId;
            var existingVehicles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Vehicles));
            var existingInjuries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Injuries));

            var data = {
                SummaryId: summaryId,
                CrNo: @Html.Raw(Json.Serialize(Model.Summary.CrNo)),
                CasNo: @Html.Raw(Json.Serialize(Model.Summary.CasNo)),
                Station: @Html.Raw(Json.Serialize(Model.Summary.Station)),
                Route: @Html.Raw(Json.Serialize(Model.Summary.Route)),
                Location: @Html.Raw(Json.Serialize(Model.Summary.Location)),
                CrashType: @Html.Raw(Json.Serialize(Model.Summary.CrashType)),
                CrashDate: @Html.Raw(Json.Serialize(Model.Summary.CrashDate.ToString("yyyy-MM-dd"))),
                CrashTime: @Html.Raw(Json.Serialize(Model.Summary.CrashTime.HasValue ? Model.Summary.CrashTime.Value.ToString("HH:mm") : null))
            };

            var vehicles = [];       // { VehicleNumber, VehicleTypeCode, VehicleTypeName, Registration }
            var personRows = [];     // { Severity, Role, VehicleNumber, Age, Gender, Race, _row, _widgets }
            var nextVehicleNumber = 1;
            var vehicleTypeOptions = [];

            var SEVERITIES = ["Fatal", "Serious", "Slight"];
            var ROLES = ["Driver", "Passenger", "Pedestrian", "Cyclist"];

            function severityClass(s) { return s.toLowerCase(); }

            function textBox(container, value, onChange) {
                return $(container).dxTextBox({
                    value: value || "", showClearButton: true,
                    onValueChanged: function (e) { if (onChange) onChange(e.value); }
                }).dxTextBox("instance");
            }

            // ── Identification ──────────────────────────────────────────
            textBox("#crNoBox", data.CrNo, function (v) { data.CrNo = v; });
            textBox("#casNoBox", data.CasNo, function (v) { data.CasNo = v; });

            $("#stationBox").dxSelectBox({
                dataSource: {
                    load: function (o) { return $.getJSON("/api/lookup/stations", { q: o.searchValue }); },
                    byKey: function (key) { return { text: key }; }
                },
                displayExpr: "text", valueExpr: "text", value: data.Station,
                searchEnabled: true, acceptCustomValue: true, showClearButton: true,
                onValueChanged: function (e) { data.Station = e.value; }
            });

            $("#crashDateBox").dxDateBox({
                type: "date", displayFormat: "dd/MM/yyyy",
                value: data.CrashDate ? new Date(data.CrashDate) : null,
                onValueChanged: function (e) { data.CrashDate = e.value ? e.value.toISOString().split("T")[0] : null; }
            });
            $("#crashTimeBox").dxDateBox({
                type: "time", displayFormat: "HH:mm", pickerType: "rollers", useMaskBehavior: true,
                value: data.CrashTime ? new Date("1970-01-01T" + data.CrashTime + ":00") : null,
                onValueChanged: function (e) {
                    data.CrashTime = e.value
                        ? e.value.getHours().toString().padStart(2, "0") + ":" + e.value.getMinutes().toString().padStart(2, "0")
                        : null;
                }
            });
            $("#crashTypeBox").dxSelectBox({
                dataSource: {
                    load: function (o) { return $.getJSON("/api/lookup/crashtypes", { q: o.searchValue }); },
                    byKey: function (key) { return { text: key }; }
                },
                displayExpr: "text", valueExpr: "text", value: data.CrashType,
                showClearButton: true, searchEnabled: true, acceptCustomValue: true,
                onValueChanged: function (e) { data.CrashType = e.value; }
            });
            $("#routeBox").dxSelectBox({
                dataSource: {
                    load: function (o) { return $.getJSON("/api/lookup/routes", { q: o.searchValue }); },
                    byKey: function (key) { return { text: key }; }
                },
                displayExpr: "text", valueExpr: "text", value: data.Route,
                showClearButton: true, searchEnabled: true, acceptCustomValue: true,
                onValueChanged: function (e) { data.Route = e.value; }
            });
            $("#locationBox").dxSelectBox({
                dataSource: {
                    load: function (o) { return $.getJSON("/api/lookup/locations", { q: o.searchValue }); },
                    byKey: function (key) { return { text: key }; }
                },
                displayExpr: "text", valueExpr: "text", value: data.Location,
                showClearButton: true, searchEnabled: true, acceptCustomValue: true,
                onValueChanged: function (e) { data.Location = e.value; }
            });

            // ── Vehicles (instance-based, pre-populated) ─────────────────
            function refreshVehicleDropdowns() {
                var items = vehicles.map(function (v) {
                    return { value: v.VehicleNumber, text: "Vehicle " + v.VehicleNumber + " — " + (v.VehicleTypeName || "?") };
                });
                personRows.forEach(function (p) {
                    if (!p._widgets || !p._widgets.vehicle) return;
                    var current = p.VehicleNumber;
                    p._widgets.vehicle.option("items", items);
                    if (current !== null && items.some(function (i) { return i.value === current; })) {
                        p._widgets.vehicle.option("value", current);
                    } else if (current !== null) {
                        p.VehicleNumber = null;
                        p._widgets.vehicle.option("value", null);
                    }
                });
            }

            function addVehicleCard(prefill) {
                var num = prefill ? prefill.VehicleNumber : nextVehicleNumber;
                nextVehicleNumber = Math.max(nextVehicleNumber, num + 1);

                var entry = prefill
                    ? { VehicleNumber: num, VehicleTypeCode: prefill.VehicleTypeCode, VehicleTypeName: prefill.VehicleTypeName, Registration: prefill.Registration }
                    : { VehicleNumber: num, VehicleTypeCode: null, VehicleTypeName: null, Registration: null };
                vehicles.push(entry);

                var card = $("<div class='qa-vehicle-card'>").appendTo("#vehicleCards");
                $("<div class='qa-vehicle-badge'>").text(num).appendTo(card);

                var typeDiv = $("<div style='flex:1;'>").appendTo(card);
                typeDiv.dxSelectBox({
                    items: vehicleTypeOptions, displayExpr: "text", valueExpr: "value",
                    placeholder: "Vehicle type...", searchEnabled: true,
                    value: entry.VehicleTypeCode,
                    onValueChanged: function (e) {
                        entry.VehicleTypeCode = e.value;
                        var match = vehicleTypeOptions.find(function (o) { return o.value === e.value; });
                        entry.VehicleTypeName = match ? match.text : null;
                        refreshVehicleDropdowns();
                    }
                });

                var regDiv = $("<div style='flex:1;'>").appendTo(card);
                regDiv.dxTextBox({
                    placeholder: "Registration (optional)", value: entry.Registration,
                    onValueChanged: function (e) { entry.Registration = e.value; }
                });

                $("<button class='qa-person-remove' title='Remove vehicle'>").html("&times;").appendTo(card).on("click", function () {
                    var idx = vehicles.indexOf(entry);
                    if (idx > -1) vehicles.splice(idx, 1);
                    card.remove();

                    var affected = personRows.filter(function (p) { return p.VehicleNumber === num; });
                    if (affected.length > 0) {
                        affected.forEach(function (p) {
                            p.VehicleNumber = null;
                            if (p._widgets && p._widgets.vehicle) p._widgets.vehicle.option("value", null);
                        });
                        DevExpress.ui.notify(
                            affected.length + " casualty entr" + (affected.length === 1 ? "y was" : "ies were") +
                            " linked to that vehicle — vehicle selection cleared, please reassign.",
                            "warning", 4500
                        );
                    }
                    refreshVehicleDropdowns();
                });
            }

            $.getJSON("/api/lookup/vehicletypes").done(function (items) {
                vehicleTypeOptions = (items || []).map(function (i) {
                    return { value: i.value, text: i.text };
                });

                if (existingVehicles.length > 0) {
                    existingVehicles.forEach(function (v) { addVehicleCard(v); });
                } else {
                    addVehicleCard(null);
                }
                refreshVehicleDropdowns();

                // Person rows (need vehicle options ready first, since a
                // pre-filled row may reference an existing vehicle number)
                existingInjuries.forEach(function (inj) { addPersonRow(inj.Severity, inj.Role, inj); });
            });

            $("#btnAddVehicle").dxButton({
                text: "Add vehicle", icon: "plus", type: "normal", stylingMode: "outlined",
                onClick: function () { addVehicleCard(null); }
            });

            // ── Casualties: grid drives generated rows, rows drive the grid ──
            var stepperWidgets = {};

            function groupKey(sev, role) { return sev + ":" + role; }
            function countFor(sev, role) { return personRows.filter(function (p) { return p.Severity === sev && p.Role === role; }).length; }
            function syncStepperDisplay(sev, role) {
                var w = stepperWidgets[groupKey(sev, role)];
                if (w) w.countEl.text(countFor(sev, role));
            }

            function addPersonRow(sev, role, prefill) {
                var entry = prefill
                    ? { Severity: sev, Role: role, VehicleNumber: prefill.VehicleNumber, Age: prefill.Age, Gender: prefill.Gender, Race: prefill.Race, _widgets: {} }
                    : { Severity: sev, Role: role, VehicleNumber: null, Age: null, Gender: null, Race: null, _widgets: {} };
                personRows.push(entry);

                var cls = severityClass(sev);
                var row = $("<div class='qa-person-row " + cls + "'>").appendTo("#personRows");

                $("<div class='qa-person-label'>").text(sev + " · " + role).appendTo(row);

                var vehicleDiv = $("<div>").appendTo(row);
                var noVehicle = (role === "Pedestrian" || role === "Cyclist");
                entry._widgets.vehicle = vehicleDiv.dxSelectBox({
                    items: vehicles.map(function (v) { return { value: v.VehicleNumber, text: "Vehicle " + v.VehicleNumber + " — " + (v.VehicleTypeName || "?") }; }),
                    displayExpr: "text", valueExpr: "value",
                    placeholder: noVehicle ? "No vehicle" : "Which vehicle?",
                    disabled: noVehicle, value: entry.VehicleNumber,
                    onValueChanged: function (e) { entry.VehicleNumber = e.value; }
                }).dxSelectBox("instance");

                var genderDiv = $("<div>").appendTo(row);
                genderDiv.dxSelectBox({
                    items: [{ text: "M", value: "M" }, { text: "F", value: "F" }],
                    displayExpr: "text", valueExpr: "value", placeholder: "Gender", value: entry.Gender,
                    onValueChanged: function (e) { entry.Gender = e.value; }
                });

                var ageDiv = $("<div>").appendTo(row);
                ageDiv.dxNumberBox({
                    placeholder: "Age", min: 0, max: 120, value: entry.Age,
                    onValueChanged: function (e) { entry.Age = e.value; }
                });

                var raceDiv = $("<div>").appendTo(row);
                raceDiv.dxSelectBox({
                    items: [
                        { text: "African (B)", value: "B" }, { text: "Coloured (C)", value: "C" },
                        { text: "Indian (I)", value: "I" }, { text: "White (W)", value: "W" }, { text: "Other (O)", value: "O" }
                    ],
                    displayExpr: "text", valueExpr: "value", placeholder: "Race", value: entry.Race,
                    onValueChanged: function (e) { entry.Race = e.value; }
                });

                $("<button class='qa-person-remove' title='Remove'>").html("&times;").appendTo(row).on("click", function () {
                    var hasData = entry.Age !== null || entry.Gender || entry.Race || entry.VehicleNumber !== null;
                    if (hasData && !confirm("This entry has details filled in. Remove it anyway?")) return;
                    var idx = personRows.indexOf(entry);
                    if (idx > -1) personRows.splice(idx, 1);
                    row.remove();
                    syncStepperDisplay(sev, role);
                });

                entry._row = row;
                syncStepperDisplay(sev, role);
            }

            function removeLastPersonRow(sev, role) {
                for (var i = personRows.length - 1; i >= 0; i--) {
                    var p = personRows[i];
                    if (p.Severity === sev && p.Role === role) {
                        var hasData = p.Age !== null || p.Gender || p.Race || p.VehicleNumber !== null;
                        if (hasData && !confirm("The last " + sev.toLowerCase() + " " + role.toLowerCase() +
                            " entry has details filled in. Remove it anyway?")) return false;
                        p._row.remove();
                        personRows.splice(i, 1);
                        return true;
                    }
                }
                return false;
            }

            SEVERITIES.forEach(function (sev) {
                $("<div class='qa-row-header " + severityClass(sev) + "'>").text(sev).appendTo("#casualtyGrid");
                ROLES.forEach(function (role) {
                    var cell = $("<div class='qa-stepper " + severityClass(sev) + "'>").appendTo("#casualtyGrid");
                    var minusBtn = $("<button type='button' class='qa-stepper-btn'>").text("-").appendTo(cell);
                    var countEl = $("<span class='qa-stepper-count'>").text("0").appendTo(cell);
                    var plusBtn = $("<button type='button' class='qa-stepper-btn'>").text("+").appendTo(cell);

                    stepperWidgets[groupKey(sev, role)] = { countEl: countEl };

                    plusBtn.on("click", function () { addPersonRow(sev, role, null); });
                    minusBtn.on("click", function () { removeLastPersonRow(sev, role); syncStepperDisplay(sev, role); });
                });
            });

            // ── Save / Cancel ─────────────────────────────────────────────
            $("#btnSave").dxButton({
                text: "Save changes",
                type: "default",
                icon: "save",
                onClick: function () {
                    if (!data.Station) {
                        DevExpress.ui.notify("Station is required.", "warning", 3000);
                        return;
                    }
                    if (!data.CrNo) {
                        DevExpress.ui.notify("CR number is required.", "warning", 3000);
                        return;
                    }

                    var incompleteVehicles = vehicles.filter(function (v) { return !v.VehicleTypeCode; });
                    if (incompleteVehicles.length > 0) {
                        DevExpress.ui.notify("Every vehicle needs a type selected.", "error", 4000);
                        return;
                    }

                    var cleanVehicles = vehicles.map(function (v) {
                        return { VehicleNumber: v.VehicleNumber, VehicleTypeCode: v.VehicleTypeCode, VehicleTypeName: v.VehicleTypeName, Registration: v.Registration };
                    });
                    var cleanPersonRows = personRows.map(function (p) {
                        return { Severity: p.Severity, Role: p.Role, VehicleNumber: p.VehicleNumber, Age: p.Age, Gender: p.Gender, Race: p.Race };
                    });

                    var payload = $.extend({}, data, {
                        vehiclesJson: JSON.stringify(cleanVehicles),
                        injuriesJson: JSON.stringify(cleanPersonRows)
                    });

                    $.post("/Crashes/EditSummary", $.extend({
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                    }, payload))
                    .done(function (res) {
                        if (res.success) {
                            DevExpress.ui.notify(res.message, "success", 4000);
                            window.location.href = "/Crashes";
                        } else {
                            DevExpress.ui.notify(res.message, "error", 4000);
                        }
                    })
                    .fail(function () {
                        DevExpress.ui.notify("Something went wrong. Please try again.", "error", 3500);
                    });
                }
            });

            $("#btnCancel").dxButton({
                text: "Cancel",
                stylingMode: "outlined",
                onClick: function () { window.location.href = "/Crashes"; }
            });
        });
    </script>
    @Html.AntiForgeryToken()
}
