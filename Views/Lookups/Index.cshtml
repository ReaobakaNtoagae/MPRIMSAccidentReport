@{
    ViewData["Title"] = "Manage Lookups";
}

<style>
    .lk-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .lk-card-head {
        padding: 14px 20px;
        border-bottom: 1px solid #f0f4f0;
    }

    .lk-head-label {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .9px;
        color: #2e7d32;
    }

    .lk-head-meta {
        font-size: .75rem;
        color: #9ca3af;
        margin-top: 2px;
    }

    /* Add-new bar sits above each grid */
    .add-bar {
        display: flex;
        gap: 8px;
        align-items: flex-end;
        padding: 12px 16px;
        background: #f9fdf9;
        border-bottom: 1px solid #f0f4f0;
    }

        .add-bar > div:first-child {
            flex: 1;
        }

    /* Remove tab panel's own border so the card border is the frame */
    .dx-tabpanel .dx-multiview-wrapper {
        border: none !important;
    }

    .dx-tabpanel .dx-tabs {
        border-bottom: 1px solid #f0f4f0 !important;
        background: #fafafa !important;
    }

    .dx-datagrid.dx-datagrid-borders {
        border: none !important;
    }

    .dx-datagrid-pager {
        padding: 10px 16px !important;
        border-top: 1px solid #f0f4f0 !important;
    }
</style>

<div class="lk-card">
    <div class="lk-card-head">
        <div class="lk-head-label">Lookup Table Management</div>
        <div class="lk-head-meta">Add or remove values used in dropdowns across the CR1 wizard</div>
    </div>

    <div id="lookupTabs"></div>
</div>

@section Scripts {
    <script>
        $(function () {

            // ── Generic helper: build one lookup tab ──────────────────
            // IMPORTANT: DevExtreme dxTabPanel template receives THREE arguments:
            //   function(itemData, itemIndex, itemElement)
            // The previous version only declared two, so 'container' was
            // receiving itemIndex (a number) — nothing was ever appended.
            function makeLookupTab(title, endpoint, idField, textField, extraCols) {
                return {
                    title: title,
                    template: function (itemData, itemIndex, container) {

                        var wrap = $("<div>").appendTo(container);

                        // ── Add-new bar ────────────────────────────────
                        var addBar   = $("<div class='add-bar'>").appendTo(wrap);
                        var inputWrap = $("<div>").appendTo(addBar);
                        var btnWrap   = $("<div>").css("min-width", "100px").appendTo(addBar);

                        var inputInst = inputWrap.dxTextBox({
                            placeholder: "Add new " + title.toLowerCase() + "…",
                            showClearButton: true,
                            onEnterKey: function () { doAdd(); }
                        }).dxTextBox("instance");

                        btnWrap.dxButton({
                            text: "Add",
                            type: "default",
                            icon: "plus",
                            onClick: function () { doAdd(); }
                        });

                        // ── Grid ───────────────────────────────────────
                        var gridWrap = $("<div>").appendTo(wrap);
                        var gridInst;

                        function doAdd() {
                            var val = (inputInst.option("value") || "").trim();
                            if (!val) {
                                DevExpress.ui.notify("Please enter a value.", "warning", 2000);
                                return;
                            }

                            $.ajax({
                                url: "/api/lookup/" + endpoint,
                                method: "POST",
                                contentType: "application/json",
                                data: JSON.stringify({ text: val }),
                                success: function (result) {
                                    DevExpress.ui.notify(
                                        "'" + (result.text || val) + "' added.", "success", 2500);
                                    inputInst.option("value", "");
                                    if (gridInst) gridInst.getDataSource().reload();
                                },
                                error: function (xhr) {
                                    var msg = (xhr.responseJSON && xhr.responseJSON.message)
                                        ? xhr.responseJSON.message
                                        : "Could not add — it may already exist.";
                                    DevExpress.ui.notify(msg, "error", 4000);
                                }
                            });
                        }

                        // Build column list
                        var cols = [
                            { dataField: textField, caption: "Value", minWidth: 200 }
                        ];
                        if (extraCols) {
                            cols = cols.concat(extraCols);
                        }
                        cols.push({
                            caption: "", width: 70, alignment: "center",
                            allowSorting: false, allowFiltering: false,
                            cellTemplate: function (el, info) {
                                $("<div>").appendTo(el).dxButton({
                                    icon: "trash",
                                    hint: "Remove",
                                    type: "danger",
                                    stylingMode: "outlined",
                                    onClick: function () {
                                        DevExpress.ui.dialog.confirm(
                                            "Remove <b>" + info.data[textField] + "</b>?",
                                            "Confirm"
                                        ).then(function (ok) {
                                            if (!ok) return;
                                            $.ajax({
                                                url: "/api/lookup/" + endpoint + "/" + info.data[idField],
                                                method: "DELETE",
                                                success: function () {
                                                    DevExpress.ui.notify("Removed.", "success", 2000);
                                                    if (gridInst) gridInst.getDataSource().reload();
                                                },
                                                error: function () {
                                                    DevExpress.ui.notify(
                                                        "Could not remove — it may be in use.", "error", 3500);
                                                }
                                            });
                                        });
                                    }
                                });
                            }
                        });

                        gridInst = gridWrap.dxDataGrid({
                            dataSource: {
                                load: function () {
                                    return $.getJSON("/api/lookup/" + endpoint)
                                        .fail(function () {
                                            DevExpress.ui.notify(
                                                "Could not load " + title + ". " +
                                                "Check that the API endpoint /api/lookup/" + endpoint + " exists.",
                                                "error", 5000);
                                        });
                                }
                            },
                            columns: cols,
                            searchPanel:           { visible: true, placeholder: "Search…", width: 220 },
                            paging:                { pageSize: 20 },
                            pager:                 { showInfo: true, infoText: "{0}–{1} of {2}" },
                            showBorders:           false,
                            rowAlternationEnabled: true,
                            hoverStateEnabled:     true,
                            noDataText:            "No " + title.toLowerCase() + " found. Add one above."
                        }).dxDataGrid("instance");
                    }
                };
            }

            // ── Tab panel ──────────────────────────────────────────────
            // deferRendering: true (default) means each tab's template
            // is called the first time that tab is selected — which is
            // why the template signature matters so much.
            $("#lookupTabs").dxTabPanel({
                animationEnabled: false,
                swipeEnabled: false,
                selectedIndex: 0,
                items: [
                    makeLookupTab(
                        "SAPS Stations", "stations", "id", "text",
                        [
                            { dataField: "province", caption: "Province", width: 100 },
                            { dataField: "district", caption: "District", width: 150 }
                        ]
                    ),
                    makeLookupTab(
                    "Locations", "locations", "id", "text",
                    [
                        { dataField: "station",  caption: "Station",  width: 150 },
                        { dataField: "province", caption: "Province", width: 100 }
                    ]
                    ),
                    makeLookupTab(
                        "Routes", "routes", "id", "text",
                        [
                            { dataField: "description", caption: "Description", minWidth: 160 }
                        ]
                    ),
                    makeLookupTab(
                        "Crash Types", "crashtypes", "id", "text",
                        [
                            { dataField: "description", caption: "Description", minWidth: 200 }
                        ]
                    ),
                    makeLookupTab(
                        "Vehicle Types", "vehicletypes", "id", "text",
                        [
                            { dataField: "description", caption: "Description", minWidth: 200 }
                        ]
                    )
                ]
            });
        });
    </script>
}
