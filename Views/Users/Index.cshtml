@{
    ViewData["Title"] = "User Management";
}

<style>
    /* ── Card shell ───────────────────────────────────────────── */
    .um-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .um-card-head {
        padding: 14px 20px;
        border-bottom: 1px solid #f0f4f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .um-head-label {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .9px;
        color: #2e7d32;
    }

    .um-head-meta {
        font-size: .75rem;
        color: #9ca3af;
        margin-top: 2px;
    }

    .um-card-body {
        padding: 0; /* grid sits edge-to-edge inside the card */
    }

    /* ── Status pill ──────────────────────────────────────────── */
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .2px;
    }

        .status-pill.active {
            background: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #c8e6c9;
        }

        .status-pill.inactive {
            background: #f5f5f5;
            color: #9e9e9e;
            border: 1px solid #e0e0e0;
        }

        .status-pill::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
            flex-shrink: 0;
        }

    /* ── Role badge ───────────────────────────────────────────── */
    .role-badge {
        display: inline-block;
        padding: 2px 9px;
        border-radius: 4px;
        font-size: .72rem;
        font-weight: 600;
        background: #f3f4f6;
        color: #374151;
        border: 1px solid #e5e7eb;
        font-family: 'DM Mono', monospace;
    }

    /* ── Action button strip ──────────────────────────────────── */
    .action-strip {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 2px 0;
    }

    /* ── Password rules checklist ────────────────────────────────── */
    .pw-rules {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-top: -8px;
        margin-bottom: 4px;
    }

    .pw-rule {
        font-size: .74rem;
        color: #9ca3af;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .pw-rule.met {
            color: #2e7d32;
        }

        .pw-rule .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #d1d5db;
            flex-shrink: 0;
        }

        .pw-rule.met .dot {
            background: #2e7d32;
        }

    /* ── Grid overrides ───────────────────────────────────────── */
    .dx-datagrid-rowsview .dx-row > td {
        vertical-align: middle !important;
        padding-top: 10px !important;
        padding-bottom: 10px !important;
    }
   
    .dx-datagrid.dx-datagrid-borders {
        border: none !important;
    }

    /* Footer pager padding */
    .dx-datagrid-pager {
        padding: 10px 20px !important;
        border-top: 1px solid #f0f4f0 !important;
    }

    /* Empty state */
    .dx-datagrid-nodata {
        font-size: .85rem !important;
        color: #9ca3af !important;
    }

    #usersGrid .dx-datagrid {
    font-size: 12px;
    }

    #usersGrid .dx-datagrid-headers {
    font-size: 11px;
    font-weight: 600;
    }

   
    .dx-datagrid-rowsview .dx-row > td {
    vertical-align: middle !important;
    padding-top: 7px !important;
    padding-bottom: 7px !important;
    }
</style>

<div class="um-card">
    <div class="um-card-head">
        <div>
            <div class="um-head-label">User Management</div>
            <div class="um-head-meta">Manage user accounts, roles, and access</div>
        </div>
        <div id="btnAddUser"></div>
    </div>
    <div class="um-card-body">
        <div id="usersGrid"></div>
    </div>
</div>

<div id="createUserPopup"></div>

@section Scripts {
    <script>
        $(function () {
            // Role names come from AspNetRoles (via /Users/GetRoles), district
            // names come from lkp_district (via /Lookups/Districts) — neither
            // is hardcoded, so both dropdowns always reflect what actually
            // exists in the database rather than a stale copy in the view.
            var roles = [];
            var districts = [];

            function loadRoles() {
                return $.getJSON("/Users/GetRoles").done(function (data) {
                    roles = data || [];
                });
            }
            function loadDistricts() {
                return $.getJSON("/api/lookup/districts").done(function (data) {
                    districts = data || [];
                });
            }

            var lookupsReady = $.when(loadRoles(), loadDistricts());

            // ── Password rules — mirrors AddIdentity's Password options exactly.
            // If the server-side policy in Program.cs changes, this list needs
            // to change with it, or the checklist will show green while Identity
            // still rejects the password (or vice versa).
            var pwRuleDefs = [
                { key: "length", label: "At least 12 characters", test: function (v) { return v.length >= 12; } },
                { key: "upper",  label: "One uppercase letter",   test: function (v) { return /[A-Z]/.test(v); } },
                { key: "lower",  label: "One lowercase letter",   test: function (v) { return /[a-z]/.test(v); } },
                { key: "digit",  label: "One number",             test: function (v) { return /[0-9]/.test(v); } },
                { key: "symbol", label: "One symbol",             test: function (v) { return /[^A-Za-z0-9]/.test(v); } },
                { key: "unique", label: "At least 4 unique characters", test: function (v) { return new Set(v.split("")).size >= 4; } }
            ];

            function passwordMeetsPolicy(v) {
                return pwRuleDefs.every(function (r) { return r.test(v || ""); });
            }

            // Builds the checklist markup for a given container id, so create
            // and edit forms can each have their own independent instance.
            function buildPasswordRulesHtml(containerId) {
                var html = '<div class="pw-rules" id="' + containerId + '">';
                pwRuleDefs.forEach(function (r) {
                    html += '<div class="pw-rule" data-rule="' + r.key + '"><span class="dot"></span><span>' + r.label + '</span></div>';
                });
                html += '</div>';
                return html;
            }

            function updatePasswordRulesUi(containerId, value) {
                pwRuleDefs.forEach(function (r) {
                    $('#' + containerId + ' [data-rule="' + r.key + '"]').toggleClass('met', r.test(value || ""));
                });
            }

            // ── Add user button ────────────────────────────────────────
            $("#btnAddUser").dxButton({
                text: "Add user",
                icon: "plus",
                type: "default",
                stylingMode: "outlined",
                onClick: function () {
                    // Refresh in case a role/district was added since page load
                    lookupsReady.done(function () {
                        createPopupInst.option("visible", true);
                    });
                }
            });

            // ── Users grid ────────────────────────────────────────────
            var gridInst = $("#usersGrid").dxDataGrid({
                dataSource: {
                    load: function () { return $.getJSON("/Users/GetAll"); }
                },
                remoteOperations: false,
                paging:    { pageSize: 15 },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [10, 15, 25, 50],
                    showInfo: true,
                    infoText: "{0}–{1} of {2} users"
                },
                sorting:   { mode: "single" },
                filterRow: { visible: true },
                showBorders: false,
                rowAlternationEnabled: true,
                hoverStateEnabled: true,
                columnAutoWidth: false,
                columns: [
                    {
                        dataField: "FullName",
                        caption: "Name",
                        width: 200,
                        cellTemplate: function (el, info) {
                            var initial = (info.value || "?")[0].toUpperCase();
                            var wrap = $('<div>').css({ display:"flex", alignItems:"center", gap:"10px" });
                            $('<div>').text(initial).css({
                                width:"32px", height:"32px", borderRadius:"50%",
                                background:"#e8f5e9", border:"1.5px solid #c8e6c9",
                                color:"#2e7d32", fontWeight:"700", fontSize:".78rem",
                                display:"flex", alignItems:"center", justifyContent:"center",
                                flexShrink:"0", fontFamily:"'DM Mono', monospace"
                            }).appendTo(wrap);
                            $('<span>').text(info.value || "—").css({
                                fontSize:".85rem", fontWeight:"600", color:"#111827"
                            }).appendTo(wrap);
                            wrap.appendTo(el);
                        }
                    },
                    {
                        dataField: "Email",
                        caption: "Email",
                        minWidth: 200,
                        cellTemplate: function (el, info) {
                            $('<span>').text(info.value || "—").css({
                                fontSize:".82rem", color:"#6b7280"
                            }).appendTo(el);
                        }
                    },
                    { dataField: "District", caption: "District", width: 130, cssClass: "dx-text-muted" },
                    {
                        dataField: "Roles",
                        caption: "Role",
                        width: 150,
                        cellTemplate: function (el, info) {
                            var role = info.value || "No role";
                            $('<span class="role-badge">').text(role).appendTo(el);
                        }
                    },
                    {
                        dataField: "IsActive",
                        caption: "Status",
                        width: 110,
                        alignment: "center",
                        cellTemplate: function (el, info) {
                            var cls  = info.value ? "active" : "inactive";
                            var text = info.value ? "Active"  : "Inactive";
                            $('<span>').addClass("status-pill " + cls).text(text).appendTo(el);
                        }
                    },
                    {
                        caption: "Actions",
                        width: 90,
                        alignment: "center",
                        allowSorting: false,
                        allowFiltering: false,
                        cellTemplate: function (el, info) {
                            var strip = $('<div class="action-strip">').css("justifyContent", "center");

                            // Single edit action — opens the consolidated Edit form
                            $('<div>').appendTo(strip).dxButton({
                                icon: "edit",
                                hint: "Edit user",
                                stylingMode: "outlined",
                                onClick: function () {
                                    lookupsReady.done(function () { showEditDialog(info.data); });
                                }
                            });

                            strip.appendTo(el);
                        }
                    }
                ]
            }).dxDataGrid("instance");

            // ── Create user popup ──────────────────────────────────────
            var createForm;
            var createPopupInst = $("#createUserPopup").dxPopup({
                title: "Add new user",
                width: 560,
                height: "auto",
                showCloseButton: true,
                contentTemplate: function (content) {
                    var wrap = $("<div>").css("padding", "4px 0").appendTo(content);

                    createForm = $("<div>").appendTo(wrap).dxForm({
                        colCount: 2,
                        labelLocation: "top",
                        showColonAfterLabel: false,
                        items: [
                            {
                                dataField: "FullName",
                                label: { text: "Full name" },
                                colSpan: 2,
                                isRequired: true
                            },
                            {
                                dataField: "Email",
                                label: { text: "Email address" },
                                colSpan: 2,
                                isRequired: true,
                                editorOptions: { mode: "email" }
                            },
                            {
                                dataField: "District",
                                label: { text: "District" },
                                colSpan: 2,
                                isRequired: true,
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    items: districts,
                                    placeholder: "Select a district...",
                                    searchEnabled: true
                                }
                            },
                            {
                                dataField: "Role",
                                label: { text: "Role" },
                                colSpan: 2,
                                isRequired: true,
                                editorType: "dxSelectBox",
                                editorOptions: { items: roles, placeholder: "Select a role..." }
                            },
                            {
                                dataField: "Password",
                                label: { text: "Password" },
                                colSpan: 2,
                                isRequired: true,
                                editorOptions: {
                                    mode: "password",
                                    placeholder: "Enter a password",
                                    valueChangeEvent: "keyup",
                                    onValueChanged: function (e) {
                                        updatePasswordRulesUi("createPwRules", e.value);
                                    }
                                },
                                // Password is always required on create, so the
                                // rule always applies — no empty-value exception here.
                                validationRules: [
                                    {
                                        type: "custom",
                                        message: "Password doesn't meet all the requirements below.",
                                        validationCallback: function (e) {
                                            return passwordMeetsPolicy(e.value);
                                        }
                                    }
                                ]
                            },
                            {
                                itemType: "simple",
                                colSpan: 2,
                                template: function () {
                                    return $(buildPasswordRulesHtml("createPwRules"));
                                }
                            }
                        ]
                    }).dxForm("instance");

                    $("<div>").css({ marginTop: "20px", borderTop: "1px solid #f0f4f0", paddingTop: "16px" })
                        .appendTo(wrap)
                        .dxButton({
                            text: "Create user",
                            type: "default",
                            icon: "save",
                            width: "100%",
                            onClick: function () {
                                var result = createForm.validate();
                                if (!result.isValid) return;
                                var data = createForm.option("formData");
                                $.post("/Users/Create", {
                                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val(),
                                    fullName: data.FullName,
                                    email:    data.Email,
                                    district: data.District,
                                    role:     data.Role,
                                    password: data.Password
                                }).done(function () {
                                    createPopupInst.option("visible", false);
                                    DevExpress.ui.notify("User created successfully.", "success", 3000);
                                    gridInst.refresh();
                                }).fail(function () {
                                    DevExpress.ui.notify("Something went wrong. Please try again.", "error", 3500);
                                });
                            }
                        });
                }
            }).dxPopup("instance");

            // ── Edit user dialog (consolidated: profile, district, role, status, optional password) ──
            function showEditDialog(user) {
                var currentRole = user.Roles ? user.Roles.split(", ")[0] : null;

                var $popupContainer = $('<div>').appendTo('body');
                var editForm;

                var popupInstance = $popupContainer.dxPopup({
                    title: "Edit user — " + user.FullName,
                    width: 560,
                    height: "auto",
                    showCloseButton: true,
                    visible: true,
                    contentTemplate: function (content) {
                        var wrap = $("<div>").css("padding", "4px 0").appendTo(content);

                        editForm = $("<div>").appendTo(wrap).dxForm({
                            colCount: 2,
                            labelLocation: "top",
                            showColonAfterLabel: false,
                            formData: {
                                FullName: user.FullName,
                                Email: user.Email,
                                District: user.District,
                                Role: currentRole,
                                IsActive: user.IsActive,
                                NewPassword: ""
                            },
                            items: [
                                {
                                    dataField: "FullName",
                                    label: { text: "Full name" },
                                    colSpan: 2,
                                    isRequired: true
                                },
                                {
                                    dataField: "Email",
                                    label: { text: "Email address" },
                                    colSpan: 2,
                                    isRequired: true,
                                    editorOptions: { mode: "email" }
                                },
                                {
                                    dataField: "District",
                                    label: { text: "District" },
                                    colSpan: 2,
                                    isRequired: true,
                                    editorType: "dxSelectBox",
                                    editorOptions: {
                                        items: districts,
                                        placeholder: "Select a district...",
                                        searchEnabled: true
                                    }
                                },
                                {
                                    dataField: "Role",
                                    label: { text: "Role" },
                                    colSpan: 2,
                                    isRequired: true,
                                    editorType: "dxSelectBox",
                                    editorOptions: { items: roles, placeholder: "Select a role..." }
                                },
                                {
                                    dataField: "IsActive",
                                    label: { text: "Active" },
                                    editorType: "dxSwitch",
                                    editorOptions: {
                                        disabled: user.IsSelf === true
                                    }
                                },
                                {
                                    dataField: "NewPassword",
                                    label: { text: "New password (leave blank to keep current)" },
                                    colSpan: 2,
                                    editorOptions: {
                                        mode: "password",
                                        placeholder: "Leave blank to keep current password",
                                        valueChangeEvent: "keyup",
                                        onValueChanged: function (e) {
                                            var $rules = $("#editPwRules");
                                          
                                            $rules.toggle(!!e.value);
                                            updatePasswordRulesUi("editPwRules", e.value);
                                        }
                                    },
                                    
                                    validationRules: [
                                        {
                                            type: "custom",
                                            message: "Password doesn't meet all the requirements below.",
                                            validationCallback: function (e) {
                                                return !e.value || passwordMeetsPolicy(e.value);
                                            }
                                        }
                                    ]
                                },
                                {
                                    itemType: "simple",
                                    colSpan: 2,
                                    template: function () {
                                        
                                        return $(buildPasswordRulesHtml("editPwRules")).hide();
                                    }
                                }
                            ]
                        }).dxForm("instance");
                    },
                    onHiding: function () {
                        $popupContainer.remove();
                    },
                    toolbarItems: [
                        {
                            widget: "dxButton",
                            location: "after",
                            toolbar: "bottom",
                            options: {
                                text: "Save",
                                type: "default",
                                icon: "save",
                                onClick: function () {
                                    var result = editForm.validate();
                                    if (!result.isValid) return;
                                    var data = editForm.option("formData");

                                    $.post("/Users/Edit", {
                                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val(),
                                        Id: user.Id,
                                        FullName: data.FullName,
                                        Email: data.Email,
                                        District: data.District,
                                        Role: data.Role,
                                        IsActive: data.IsActive,
                                        NewPassword: data.NewPassword
                                    }).done(function () {
                                        DevExpress.ui.notify(user.FullName + " has been updated.", "success", 2500);
                                        popupInstance.hide();
                                        gridInst.refresh();
                                    }).fail(function () {
                                        DevExpress.ui.notify("Something went wrong. Please try again.", "error", 3500);
                                    });
                                }
                            }
                        },
                        {
                            widget: "dxButton",
                            location: "after",
                            toolbar: "bottom",
                            options: {
                                text: "Cancel",
                                onClick: function () {
                                    popupInstance.hide();
                                }
                            }
                        }
                    ]
                }).dxPopup("instance");
            }
        });
    </script>
    @Html.AntiForgeryToken()
}
