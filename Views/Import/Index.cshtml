@{
    ViewData["Title"] = "Import Excel Accident Report";
}

<style>
    .imp-wrap {
        max-width: 560px;
    }

    .imp-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #c8e6c9;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
        overflow: hidden;
        margin-bottom: 14px;
    }

    .imp-card-head {
        padding: 11px 20px;
        border-bottom: 2px solid #e8f5e9;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .8px;
        color: #2e7d32;
        font-weight: 700;
    }

    .imp-card-body {
        padding: 20px;
    }

    .imp-field {
        margin-bottom: 16px;
    }

        .imp-field:last-child {
            margin-bottom: 0;
        }

    .imp-field-label {
        font-size: .72rem;
        font-weight: 600;
        color: #444;
        display: block;
        margin-bottom: 5px;
    }
</style>

<div class="imp-wrap">

    @if (TempData["ImportError"] != null)
    {
        <div id="errMsg" data-msg="@TempData["ImportError"]"></div>
    }

    <div class="imp-card">
        <div class="imp-card-head">Upload Accident Report Workbook</div>
        <div class="imp-card-body">

            <form method="post"
                  asp-controller="Import"
                  asp-action="Upload"
                  enctype="multipart/form-data"
                  id="uploadForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="provinceHidden" name="province" value="MP" />

                <div class="imp-field">
                    <label class="imp-field-label">Province — applied to all imported records</label>
                    <div id="provinceSelect"></div>
                </div>

                <div class="imp-field">
                    <label class="imp-field-label">Excel File (.xlsx / .xls — maximum 10 MB)</label>
                    <div id="fileUploader"></div>
                </div>

                <div class="imp-field">
                    <div id="btnSubmit"></div>
                </div>

            </form>
        </div>
    </div>

    <div class="imp-card">
        <div class="imp-card-head">Standard Import Template</div>
        <div class="imp-card-body">
            <p style="font-size:.82rem; color:#444; line-height:1.5; margin:0 0 14px;">
                Use the standard template to avoid formatting issues on import. It has the same
                layout your station already uses, plus a District column and Fatal Age/Race
                breakdown fields (highlighted in green) that older workbooks may be missing.
            </p>
            <div id="btnDownloadTemplate"></div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(function () {

            // ── Error from previous attempt ───────────────────────────
            var errMsg = $("#errMsg").data("msg");
            if (errMsg) DevExpress.ui.notify(errMsg, "error", 5000);

            // ── Province select — sourced from formOptions.Province (the
            // same seeded list the CR1 wizard uses), not hardcoded here.
            // Defaults to "MP" once loaded, matching the hidden field's
            // fallback value for the brief moment before the fetch resolves.
            $.getJSON("/api/lookup/formoptions").done(function (formOptions) {
                var provinceCodes = formOptions.Province || [];

                $("#provinceSelect").dxSelectBox({
                    items:          provinceCodes,
                    value:          provinceCodes.indexOf("MP") > -1 ? "MP" : (provinceCodes[0] || null),
                    width:          "100%",
                    searchEnabled:  true,
                    onValueChanged: function (e) {
                        $("#provinceHidden").val(e.value);
                    }
                });

                // Keep the hidden field in sync with whatever the default
                // selection ends up being once the dropdown actually renders.
                var inst = $("#provinceSelect").dxSelectBox("instance");
                $("#provinceHidden").val(inst.option("value"));
            }).fail(function () {
                DevExpress.ui.notify("Could not load the province list. Please refresh and try again.", "error", 4000);
            });

            // ── File uploader ─────────────────────────────────────────
            // uploadMode:"useForm" means the widget does NOT upload
            // automatically — it just holds the file for the form POST.
            // The name "file" matches ImportController.Upload(IFormFile file).
            var fileUploaderInst = $("#fileUploader").dxFileUploader({
                name:             "file",
                uploadMode:       "useForm",
                accept:           ".xlsx,.xls",
                multiple:         false,
                selectButtonText: "Select Excel file",
                labelText:        "or drop it here",
                allowedFileExtensions: [".xlsx", ".xls"],
                maxFileSize:      10 * 1024 * 1024,   // 10 MB
                invalidFileExtensionMessage: "Only .xlsx and .xls files are supported.",
                invalidMaxFileSizeMessage:   "File size must not exceed 10 MB.",
                onValueChanged: function (e) {
                    var hasFile = e.value && e.value.length > 0;
                    submitBtnInst.option("disabled", !hasFile);
                }
            }).dxFileUploader("instance");

            // ── Submit button ─────────────────────────────────────────
            var submitBtnInst = $("#btnSubmit").dxButton({
                text:          "Import Records",
                type:          "default",
                icon:          "upload",
                width:         "100%",
                disabled:      true,
                onClick: function () {
                    var files = fileUploaderInst.option("value");
                    if (!files || files.length === 0) {
                        DevExpress.ui.notify("Please select an Excel file first.", "warning", 3000);
                        return;
                    }
                    submitBtnInst.option("text",     "Importing — please wait…");
                    submitBtnInst.option("disabled", true);
                    DevExpress.ui.notify("Importing workbook. This may take a moment.", "info", 10000);
                    document.getElementById("uploadForm").submit();
                }
            }).dxButton("instance");

            // ── Download template button ───────────────────────────────
            $("#btnDownloadTemplate").dxButton({
                text: "Download standard template",
                icon: "download",
                type: "normal",
                stylingMode: "outlined",
                width: "100%",
                onClick: function () {
                    window.location.href = "/Import/DownloadTemplate";
                }
            });

        });
    </script>
}
