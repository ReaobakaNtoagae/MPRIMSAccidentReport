@{
    ViewData["Title"] = "Import Excel Accident Report";
}

<style>
    .imp-wrap {
        max-width: 1120px;
        margin: 0 auto;
    }

    .imp-hero { margin-bottom:18px; }
    .imp-eyebrow { color:var(--g-600); font:600 .68rem 'DM Mono',monospace; letter-spacing:1.25px; text-transform:uppercase; margin-bottom:7px; }
    .imp-title { font-size:1.65rem; line-height:1.2; margin:0 0 7px; color:#171d25; }
    .imp-grid { display:grid; grid-template-columns:minmax(0,1fr) 280px; gap:18px; align-items:start; }

    .imp-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid var(--border);
        box-shadow: 0 8px 28px rgba(12, 18, 28, .06);
        overflow: hidden;
        margin-bottom: 14px;
    }

    .imp-card-head {
        padding: 15px 20px;
        border-bottom: 1px solid #e8ebef;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .8px;
        color: #192b45;
        font-weight: 700;
    }

    .imp-card-body {
        padding: 20px;
    }

    .imp-field {
        margin-bottom: 16px;
    }

        .imp-field:last-child {
            margin-bottom: 0;
        }

    .imp-field-label {
        font-size: .72rem;
        font-weight: 600;
        color: #444;
        display: block;
        margin-bottom: 5px;
    }

    .imp-form-row { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .imp-card .dx-texteditor { border-color:#d6dae1; border-radius:7px; }
    .imp-card .dx-texteditor.dx-state-focused { border-color:#699ba7; box-shadow:0 0 0 2px rgba(46, 71, 109, .10); }
    #fileUploader { border:1px dashed #a9b7cb; border-radius:10px; background:#f9fafc; padding:12px; }
    #btnSubmit .dx-button { height:40px; border-radius:7px; }
    #btnDownloadTemplate .dx-button { height:38px; border-radius:7px; }
    .imp-template-mark { width:44px; height:44px; margin:2px auto 14px; display:grid; place-items:center; border-radius:11px; background:#eaeef3; color:#192b45; font:700 .75rem 'DM Mono',monospace; }
    @@media(max-width:850px) { .imp-grid { grid-template-columns:1fr; } }
    @@media(max-width:560px) { .imp-form-row { grid-template-columns:1fr; gap:0; } .imp-title { font-size:1.4rem; } }
</style>

<div class="imp-wrap">

    <header class="imp-hero">
        <div>
            <div class="imp-eyebrow">Data imports</div>
            <h1 class="imp-title">Import an accident report</h1>
        </div>
    </header>

    @if (TempData["ImportError"] != null)
    {
        <div id="errMsg" data-msg="@TempData["ImportError"]"></div>
    }

    <div class="imp-grid">
    <div class="imp-card">
        <div class="imp-card-head">Upload Accident Report Workbook</div>
        <div class="imp-card-body">

            <form method="post"
                  asp-controller="Import"
                  asp-action="Upload"
                  enctype="multipart/form-data"
                  id="uploadForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="provinceHidden" name="province" value="MP" />

                <div class="imp-form-row">
                <div class="imp-field">
                    <label class="imp-field-label">Province — applied to all imported records</label>
                    <div id="provinceSelect"></div>
                </div>

                <div class="imp-field">
                    <label class="imp-field-label" for="reportingMonth">Reporting month</label>
                    <div id="reportingMonthBox"></div>
                    <input type="hidden" id="reportingMonth" name="reportingMonth" value="@DateTime.Today.Month" />
                </div>
                </div>

                <div class="imp-field">
                    <label class="imp-field-label" for="reportingYear">Reporting year</label>
                    <div id="reportingYearBox"></div>
                    <input id="reportingYear" name="reportingYear" type="hidden" value="@DateTime.Today.Year" />
                </div>

                <div class="imp-field">
                    <label class="imp-field-label" for="notes">Import notes (optional)</label>
                    <div id="notesBox"></div>
                    <input id="notes" name="notes" type="hidden" />
                </div>

                <div class="imp-field">
                    <label class="imp-field-label">Excel workbook (.xlsx — maximum 10 MB)</label>
                    <div id="fileUploader"></div>
                </div>

                <div class="imp-field">
                    <div id="btnSubmit"></div>
                </div>

            </form>
        </div>
    </div>

    <aside>
    <div class="imp-card">
        <div class="imp-card-head">Standard template</div>
        <div class="imp-card-body" style="text-align:center">
            <div class="imp-template-mark">XLSX</div>
            <div id="btnDownloadTemplate"></div>
        </div>
    </div>
    </aside>
    </div>

</div>

@section Scripts {
    <script>
        $(function () {

            
            var errMsg = $("#errMsg").data("msg");
            if (errMsg) DevExpress.ui.notify(errMsg, "error", 5000);

            
            $.getJSON("/api/lookup/formoptions").done(function (formOptions) {
                var provinceCodes = formOptions.Province || [];

                $("#provinceSelect").dxSelectBox({
                    items:          provinceCodes,
                    value:          provinceCodes.indexOf("MP") > -1 ? "MP" : (provinceCodes[0] || null),
                    width:          "100%",
                    searchEnabled:  true,
                    onValueChanged: function (e) {
                        $("#provinceHidden").val(e.value);
                    }
                });

                
                var inst = $("#provinceSelect").dxSelectBox("instance");
                $("#provinceHidden").val(inst.option("value"));
            }).fail(function () {
                DevExpress.ui.notify("Could not load the province list. Please refresh and try again.", "error", 4000);
            });

            
            var months = Array.from({ length: 12 }, function (_, index) {
                var month = index + 1;
                return { value: month, text: new Date(2000, index, 1).toLocaleString("en-ZA", { month: "long" }) };
            });
            $("#reportingMonthBox").dxSelectBox({
                items: months, displayExpr: "text", valueExpr: "value",
                value: @DateTime.Today.Month,
                onValueChanged: function (e) { $("#reportingMonth").val(e.value); }
            });
            $("#reportingYearBox").dxNumberBox({
                value: @DateTime.Today.Year, min: 2000, max: 2100, showSpinButtons: true,
                onValueChanged: function (e) { $("#reportingYear").val(e.value); }
            });
            $("#notesBox").dxTextArea({
                height: 68, maxLength: 1000,
                onValueChanged: function (e) { $("#notes").val(e.value); }
            });

            
            var fileUploaderInst = $("#fileUploader").dxFileUploader({
                name:             "file",
                uploadMode:       "useForm",
                accept:           ".xlsx",
                multiple:         false,
                selectButtonText: "Select Excel file",
                labelText:        "or drop it here",
                allowedFileExtensions: [".xlsx"],
                maxFileSize:      10 * 1024 * 1024,  
                invalidFileExtensionMessage: "Only .xlsx workbooks are supported.",
                invalidMaxFileSizeMessage:   "File size must not exceed 10 MB.",
                onValueChanged: function (e) {
                    var hasFile = e.value && e.value.length > 0;
                    submitBtnInst.option("disabled", !hasFile);
                }
            }).dxFileUploader("instance");

            
            var submitBtnInst = $("#btnSubmit").dxButton({
                text:          "Stage workbook for review",
                type:          "default",
                icon:          "upload",
                width:         "100%",
                disabled:      true,
                onClick: function () {
                    var files = fileUploaderInst.option("value");
                    if (!files || files.length === 0) {
                        DevExpress.ui.notify("Please select an Excel file first.", "warning", 3000);
                        return;
                    }
                    submitBtnInst.option("text",     "Staging — please wait…");
                    submitBtnInst.option("disabled", true);
                    DevExpress.ui.notify("Cleaning and validating the workbook in staging.", "info", 10000);
                    document.getElementById("uploadForm").submit();
                }
            }).dxButton("instance");

            
            $("#btnDownloadTemplate").dxButton({
                text: "Download standard template",
                icon: "download",
                type: "normal",
                stylingMode: "outlined",
                width: "100%",
                onClick: function () {
                    window.location.href = "/Import/DownloadTemplate";
                }
            });

        });
    </script>
}
