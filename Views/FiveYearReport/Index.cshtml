@{
    ViewData["Title"] = "Five Year Report";
}

<style>
    .fy-card {
        background: #fff; border-radius: 10px; border: 1px solid #e5e7eb;
        box-shadow: 0 1px 4px rgba(0,0,0,.06); overflow: hidden; margin-bottom: 20px;
    }
    .fy-card-head { padding: 14px 20px; border-bottom: 1px solid #f0f4f0; }
    .fy-head-label {
        font-size: .72rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: .9px; color: #2e7d32;
    }
    .fy-head-meta { font-size: .75rem; color: #9ca3af; margin-top: 2px; }
    .fy-card-body { padding: 20px; }
    .fy-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .fy-field-label {
        font-size: .72rem; font-weight: 600; color: #374151;
        text-transform: uppercase; letter-spacing: .4px; margin-bottom: 5px;
    }
    .fy-actions {
        display: flex; gap: 10px; margin-top: 20px; padding-top: 16px;
        border-top: 1px solid #f0f4f0;
    }
    .fy-caveat {
        background: #fffbeb; border: 1px solid #fde68a; border-radius: 6px;
        padding: 10px 14px; font-size: .8rem; color: #92400e; margin-bottom: 16px;
    }
    .fy-empty { text-align: center; padding: 40px 20px; color: #9ca3af; font-size: .85rem; }
</style>

<div class="fy-card">
    <div class="fy-card-head">
        <div class="fy-head-label">Five Year Report</div>
        <div class="fy-head-meta">One month analyzed across five consecutive years \u2014 provincial, regional, routes, crash types, times, days, and victim demographics</div>
    </div>
    <div class="fy-card-body">
        <div class="fy-grid">
            <div>
                <div class="fy-field-label">Month to analyze</div>
                <div id="monthBox"></div>
            </div>
            <div>
                <div class="fy-field-label">Most recent year (5-year window ends here)</div>
                <div id="endYearBox"></div>
            </div>
        </div>

        <div class="fy-grid" style="margin-top:16px;">
            <div>
                <div class="fy-field-label">Report date</div>
                <div id="reportDateBox"></div>
            </div>
            <div>
                <div class="fy-field-label">Reference number</div>
                <div id="refNumberBox"></div>
            </div>
            <div>
                <div class="fy-field-label">Enquiries \u2014 name</div>
                <div id="enquiryNameBox"></div>
            </div>
            <div>
                <div class="fy-field-label">Enquiries \u2014 telephone</div>
                <div id="enquiryTelBox"></div>
            </div>
            <div>
                <div class="fy-field-label">To (name)</div>
                <div id="toNameBox"></div>
            </div>
            <div>
                <div class="fy-field-label">To (title)</div>
                <div id="toTitleBox"></div>
            </div>
            <div>
                <div class="fy-field-label">From (name)</div>
                <div id="fromNameBox"></div>
            </div>
            <div>
                <div class="fy-field-label">From (title)</div>
                <div id="fromTitleBox"></div>
            </div>
        </div>

        <div class="fy-actions">
            <div id="btnPreview"></div>
            <div id="btnDownload"></div>
        </div>
    </div>
</div>

<div class="fy-card">
    <div class="fy-card-head">
        <div class="fy-head-label">Preview</div>
        <div class="fy-head-meta">Provincial summary and top-line figures \u2014 the downloaded document contains the full breakdown (routes, crash types, times, days, demographics per region)</div>
    </div>
    <div class="fy-card-body" id="previewBody">
        <div class="fy-empty">Select a month and end year, then click Preview.</div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {

            var currentYear = new Date().getFullYear();
            var months = [
                { value: 1, text: "January" }, { value: 2, text: "February" }, { value: 3, text: "March" },
                { value: 4, text: "April" }, { value: 5, text: "May" }, { value: 6, text: "June" },
                { value: 7, text: "July" }, { value: 8, text: "August" }, { value: 9, text: "September" },
                { value: 10, text: "October" }, { value: 11, text: "November" }, { value: 12, text: "December" }
            ];
            var years = [];
            for (var y = currentYear; y >= currentYear - 6; y--) years.push(y);

            var monthBox = $("#monthBox").dxSelectBox({
                items: months, displayExpr: "text", valueExpr: "value", value: new Date().getMonth() + 1
            }).dxSelectBox("instance");

            var endYearBox = $("#endYearBox").dxSelectBox({ items: years, value: currentYear }).dxSelectBox("instance");

            var reportDateBox = $("#reportDateBox").dxTextBox({
                value: new Date().toLocaleDateString("en-ZA", { day: "2-digit", month: "long", year: "numeric" }).toUpperCase()
            }).dxTextBox("instance");
            var refNumberBox   = $("#refNumberBox").dxTextBox({ value: "16/9/4" }).dxTextBox("instance");
            var enquiryNameBox = $("#enquiryNameBox").dxTextBox({ value: "M C Mdhluli" }).dxTextBox("instance");
            var enquiryTelBox  = $("#enquiryTelBox").dxTextBox({ value: "082 802 6966" }).dxTextBox("instance");
            var toNameBox      = $("#toNameBox").dxTextBox({ value: "MR P NGOMANE (MPL)" }).dxTextBox("instance");
            var toTitleBox     = $("#toTitleBox").dxTextBox({ value: "MEMBER OF THE EXECUTIVE COUNCIL" }).dxTextBox("instance");
            var fromNameBox    = $("#fromNameBox").dxTextBox({ value: "MR W MTHOMBOTHI" }).dxTextBox("instance");
            var fromTitleBox   = $("#fromTitleBox").dxTextBox({ value: "HEAD OF DEPARTMENT" }).dxTextBox("instance");

            function buildRequest() {
                return {
                    Month:       monthBox.option("value"),
                    EndYear:     endYearBox.option("value"),
                    ReportDate:  reportDateBox.option("value"),
                    RefNumber:   refNumberBox.option("value"),
                    EnquiryName: enquiryNameBox.option("value"),
                    EnquiryTel:  enquiryTelBox.option("value"),
                    ToName:      toNameBox.option("value"),
                    ToTitle:     toTitleBox.option("value"),
                    FromName:    fromNameBox.option("value"),
                    FromTitle:   fromTitleBox.option("value")
                };
            }

            var previewBtn = $("#btnPreview").dxButton({
                text: "Preview", icon: "preview", type: "normal", stylingMode: "outlined",
                onClick: function () { runPreview(); }
            }).dxButton("instance");

            function runPreview() {
                previewBtn.option("disabled", true);
                $("#previewBody").html('<div class="fy-empty">Loading\u2026</div>');

                fetch("/FiveYearReport/Preview", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(buildRequest())
                })
                .then(function (res) {
                    if (!res.ok) return res.json().then(function (e) { throw new Error(e.error || "Request failed."); });
                    return res.json();
                })
                .then(renderPreview)
                .catch(function (err) {
                    $("#previewBody").html('<div class="fy-empty">' + err.message + '</div>');
                    DevExpress.ui.notify(err.message, "error", 4000);
                })
                .finally(function () { previewBtn.option("disabled", false); });
            }

            function renderPreview(vm) {
                var html = '<div style="font-size:.85rem;color:#555;margin-bottom:14px;">' +
                           '<strong>' + vm.ReportTitle + '</strong> &nbsp;\u00b7&nbsp; ' +
                           vm.StartYear + '\u2013' + vm.EndYear + '</div>';

                if (vm.DemographicsHasGaps) {
                    html += '<div class="fy-caveat">Demographic data has gaps for one or more years in this range ' +
                            '(manually-captured station summaries are not always complete) \u2014 age/gender figures ' +
                            'in the downloaded document should be treated as indicative, not exhaustive.</div>';
                }

                html += '<div id="regionGrid" style="margin-bottom:20px;"></div>';
                html += '<div id="crashTypeGrid"></div>';

                $("#previewBody").html(html);

                var regionData = vm.RegionSummaries.map(function (r) {
                    var row = { Region: r.RegionName };
                    r.Stats.forEach(function (s) { row[s.Label] = s.Total; });
                    return row;
                });

                $("#regionGrid").dxDataGrid({
                    dataSource: regionData,
                    showBorders: false,
                    rowAlternationEnabled: true,
                    columns: ["Region", "CRASHES", "FATALITIES", "SERIOUS INJURIES", "SLIGHT INJURIES"]
                });

                $("#crashTypeGrid").dxDataGrid({
                    dataSource: vm.CrashTypes.Rows,
                    showBorders: false,
                    rowAlternationEnabled: true,
                    columns: [
                        { dataField: "Label", caption: "Crash Type" },
                        { dataField: "Total", caption: "Total (5yr)" },
                        { dataField: "Average", caption: "Average/yr" },
                        { dataField: "Percent", caption: "%", cellTemplate: function (el, info) {
                            $("<span>").text(info.value + "%").appendTo(el);
                        }}
                    ]
                });
            }

            var downloadBtn = $("#btnDownload").dxButton({
                text: "Download Word report", icon: "download", type: "default",
                onClick: function () { runDownload(); }
            }).dxButton("instance");

            function runDownload() {
                var req = buildRequest();
                downloadBtn.option("disabled", true);
                DevExpress.ui.notify("Generating report \u2014 this covers 5 years across every region, may take a moment\u2026", "info", 4000);

                fetch("/FiveYearReport/Download", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(req)
                })
                .then(function (res) {
                    if (!res.ok) return res.json().then(function (e) { throw new Error(e.error || "Request failed."); });
                    return res.blob();
                })
                .then(function (blob) {
                    var url = URL.createObjectURL(blob);
                    var a = document.createElement("a");
                    a.href = url;
                    a.download = "FiveYearReport_" + req.Month + "_" + req.EndYear + ".docx";
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    URL.revokeObjectURL(url);
                    DevExpress.ui.notify("Report downloaded.", "success", 3000);
                })
                .catch(function (err) {
                    DevExpress.ui.notify("Could not generate the report: " + err.message, "error", 5000);
                })
                .finally(function () { downloadBtn.option("disabled", false); });
            }

        });
    </script>
}
